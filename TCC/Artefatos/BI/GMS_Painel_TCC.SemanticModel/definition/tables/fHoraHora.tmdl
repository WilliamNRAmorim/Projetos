table fHoraHora
	lineageTag: 3d0e7a52-9b14-4c68-8f21-6a5b0c1d7e90

	/// Hora-Hora completo (1 linha por Célula x Data x Turno x Hora), com ou sem parada. Fonte: lista Hora-Hora.
	column ID
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: ID
	column Data
		dataType: dateTime
		formatString: dd/mm/yyyy
		summarizeBy: none
		sourceColumn: Data
	column Turno
		dataType: string
		summarizeBy: none
		sourceColumn: Turno
	column Célula
		dataType: string
		summarizeBy: none
		sourceColumn: Célula
	column Hora
		dataType: string
		summarizeBy: none
		sortByColumn: HoraOrdem
		sourceColumn: Hora
	column Mangueira
		dataType: string
		summarizeBy: none
		sourceColumn: Mangueira
	column Minutos
		dataType: double
		summarizeBy: none
		sourceColumn: Minutos
	column 'Meta Hora'
		dataType: double
		formatString: #,0
		summarizeBy: none
		sourceColumn: Meta Hora
	column 'Real. Hora'
		dataType: double
		formatString: #,0
		summarizeBy: none
		sourceColumn: Real. Hora
	column 'Tempo Parado (min)'
		dataType: double
		formatString: #,0.0
		summarizeBy: none
		sourceColumn: Tempo Parado (min)
	column Motivo
		dataType: string
		summarizeBy: none
		sourceColumn: Motivo
	column 'Motivo 2'
		dataType: string
		summarizeBy: none
		sourceColumn: Motivo 2
	column Status
		dataType: string
		summarizeBy: none
		sourceColumn: Status

	/// Ordem da janela dentro do turno (valor pronto; madrugada do 3º turno soma 24h).
	column HoraOrdem
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none
		sourceColumn: HoraOrdem

	/// Igual à Hora-Hora[Motivo Padrão], mas texto vazio vira BLANK (a Hora-Hora só tem linhas com motivo).
	column 'Motivo Padrão' =
			VAR t = TRIM ( 'fHoraHora'[Motivo] )
			VAR p = IFERROR ( SEARCH ( "-", t ), 0 )
			VAR pre = IF ( p > 1, TRIM ( LEFT ( t, p - 1 ) ), "" )
			VAR limpo = IF ( IFERROR ( VALUE ( pre ), -1 ) >= 0, TRIM ( MID ( t, p + 1, 300 ) ), t )
			RETURN
			    IF (
			        t = "" || ISBLANK ( t ), BLANK (),
			        SWITCH ( TRUE (),
			            limpo = "Refeição", "Almoço",
			            limpo = "Problema no tubo", "Análise/Problema no tubo",
			            limpo )
			    )
		dataType: string
		summarizeBy: none

	column 'Motivo 2 Padrão' =
			VAR t = TRIM ( 'fHoraHora'[Motivo 2] )
			VAR p = IFERROR ( SEARCH ( "-", t ), 0 )
			VAR pre = IF ( p > 1, TRIM ( LEFT ( t, p - 1 ) ), "" )
			VAR limpo = IF ( IFERROR ( VALUE ( pre ), -1 ) >= 0, TRIM ( MID ( t, p + 1, 300 ) ), t )
			RETURN
			    IF (
			        t = "" || ISBLANK ( t ), BLANK (),
			        SWITCH ( TRUE (),
			            limpo = "Refeição", "Almoço",
			            limpo = "Problema no tubo", "Análise/Problema no tubo",
			            limpo )
			    )
		dataType: string
		summarizeBy: none

