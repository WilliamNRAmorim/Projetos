{
  "name": "GMS Fluxo Trançagem (escuro)",
  "dataColors": ["#5b9bf0", "#5fcf75", "#ff8a50", "#f06464", "#9aa5b3", "#2a78d6", "#0ca30c", "#eb6834", "#d03b3b", "#5b6675"],
  "background": "#1a212b",
  "foreground": "#e7ebf0",
  "tableAccent": "#5b9bf0",
  "good": "#5fcf75",
  "neutral": "#ff8a50",
  "bad": "#f06464",
  "maximum": "#5b9bf0",
  "center": "#9aa5b3",
  "minimum": "#22344d",
  "null": "#333d4a",
  "hyperlink": "#5b9bf0",
  "visitedHyperlink": "#9aa5b3",
  "textClasses": {
    "callout": { "fontSize": 24, "fontFace": "Segoe UI Semibold", "color": "#e7ebf0" },
    "title": { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#e7ebf0" },
    "header": { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#e7ebf0" },
    "label": { "fontSize": 10, "fontFace": "Segoe UI", "color": "#9aa5b3" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#1a212b" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#2b3440" } }, "radius": 12 }],
        "dropShadow": [{ "show": false }],
        "padding": [{ "top": 12, "bottom": 12, "left": 14, "right": 14 }],
        "title": [{ "show": true, "fontColor": { "solid": { "color": "#e7ebf0" } }, "fontSize": 12, "fontFamily": "Segoe UI Semibold", "alignment": "left" }],
        "subTitle": [{ "fontColor": { "solid": { "color": "#9aa5b3" } }, "fontSize": 10, "fontFamily": "Segoe UI" }],
        "visualHeader": [{ "background": { "solid": { "color": "#1a212b" } }, "border": { "solid": { "color": "#2b3440" } }, "foreground": { "solid": { "color": "#9aa5b3" } } }],
        "visualTooltip": [{ "titleFontColor": { "solid": { "color": "#9aa5b3" } }, "valueFontColor": { "solid": { "color": "#e7ebf0" } }, "background": { "solid": { "color": "#11161d" } } }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#11161d" } }, "transparency": 0 }],
        "outspace": [{ "color": { "solid": { "color": "#11161d" } }, "transparency": 0 }]
      }
    },
    "slicer": {
      "*": {
        "header": [{ "show": true, "fontColor": { "solid": { "color": "#9aa5b3" } }, "textSize": 10, "fontFamily": "Segoe UI" }],
        "items": [{ "fontColor": { "solid": { "color": "#e7ebf0" } }, "background": { "solid": { "color": "#1a212b" } }, "textSize": 11, "fontFamily": "Segoe UI" }]
      }
    },
    "card": {
      "*": {
        "labels": [{ "color": { "solid": { "color": "#e7ebf0" } }, "fontSize": 24, "fontFamily": "Segoe UI Semibold" }],
        "categoryLabels": [{ "show": true, "color": { "solid": { "color": "#9aa5b3" } }, "fontSize": 10, "fontFamily": "Segoe UI" }]
      }
    },
    "lineChart": {
      "*": {
        "categoryAxis": [{ "labelColor": { "solid": { "color": "#9aa5b3" } }, "fontSize": 9, "showAxisTitle": false, "gridlineShow": false }],
        "valueAxis": [{ "labelColor": { "solid": { "color": "#9aa5b3" } }, "fontSize": 9, "showAxisTitle": false, "gridlineShow": true, "gridlineColor": { "solid": { "color": "#2b3440" } } }],
        "legend": [{ "show": true, "position": "Top", "labelColor": { "solid": { "color": "#9aa5b3" } }, "fontSize": 10 }],
        "lineStyles": [{ "strokeWidth": 2 }]
      }
    },
    "pivotTable": {
      "*": {
        "grid": [{ "gridVertical": false, "gridHorizontal": false, "outlineColor": { "solid": { "color": "#1a212b" } }, "rowPadding": 0 }],
        "columnHeaders": [{ "fontColor": { "solid": { "color": "#9aa5b3" } }, "backColor": { "solid": { "color": "#1a212b" } }, "fontFamily": "Segoe UI", "fontSize": 9 }],
        "values": [{ "fontColorPrimary": { "solid": { "color": "#e7ebf0" } }, "backColorPrimary": { "solid": { "color": "#1a212b" } }, "fontColorSecondary": { "solid": { "color": "#e7ebf0" } }, "backColorSecondary": { "solid": { "color": "#1a212b" } } }]
      }
    },
    "tableEx": {
      "*": {
        "grid": [{ "gridVertical": false, "gridHorizontal": true, "gridHorizontalColor": { "solid": { "color": "#2b3440" } }, "outlineColor": { "solid": { "color": "#1a212b" } } }],
        "columnHeaders": [{ "fontColor": { "solid": { "color": "#9aa5b3" } }, "backColor": { "solid": { "color": "#1a212b" } }, "fontFamily": "Segoe UI", "fontSize": 9 }],
        "values": [{ "fontColorPrimary": { "solid": { "color": "#e7ebf0" } }, "backColorPrimary": { "solid": { "color": "#1a212b" } }, "fontColorSecondary": { "solid": { "color": "#e7ebf0" } }, "backColorSecondary": { "solid": { "color": "#1a212b" } }, "fontFamily": "Segoe UI", "fontSize": 11 }]
      }
    },
    "textbox": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#1a212b" } }, "transparency": 0 }]
      }
    }
  }
}
