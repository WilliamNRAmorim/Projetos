            FILTER (
                SELECTCOLUMNS (
                    FILTER ( ALL ( ficha_producao ), NOT ISBLANK ( ficha_producao[data_hora_final_bandagem] ) ),
                    "@E", 5,
                    "@Dia", VAR __fS5 = ficha_producao[data_hora_final_bandagem] - 320 / 1440 RETURN DATE ( YEAR ( __fS5 ), MONTH ( __fS5 ), DAY ( __fS5 ) ),
                    "@T", VAR __mS5 = HOUR ( ficha_producao[data_hora_final_bandagem] ) * 60 + MINUTE ( ficha_producao[data_hora_final_bandagem] ) RETURN IF ( __mS5 >= 320 && __mS5 < 837, 1, IF ( __mS5 >= 837 && __mS5 < 1340, 2, 3 ) ),
                    "@Q", VAR __qS5 = ficha_producao[quantidade_bandagem] RETURN IF ( __qS5 > 2000, BLANK (), __qS5 ),
                    "@M", VAR __mqS5 = UPPER ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( ficha_producao[Trançadeira], ".", "" ), "-", "" ), " ", "" ), "_", "" ) ) RETURN IF ( __mqS5 IN { "SPIRAL", "TE01", "TE0" }, "SPIRAL", __mqS5 ),
                    "@Op", SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(UPPER ( ficha_producao[operador_bandagem] ),"Á","A"),"À","A"),"Â","A"),"Ã","A"),"Ä","A"),"É","E"),"È","E"),"Ê","E"),"Ë","E"),"Í","I"),"Ì","I"),"Î","I"),"Ï","I"),"Ó","O"),"Ò","O"),"Ô","O"),"Õ","O"),"Ö","O"),"Ú","U"),"Ù","U"),"Û","U"),"Ü","U"),"Ç","C"),"Ñ","N"),".",""),",",""),"-",""),"_",""),"/","|")
                ),
                [@Dia] IN __Datas
            ),
            FILTER (
                SELECTCOLUMNS (
                    FILTER ( ALL ( ficha_producao ), NOT ISBLANK ( ficha_producao[data_hora_final_vulcanizacao] ) ),
                    "@E", 6,
                    "@Dia", VAR __fS6 = ficha_producao[data_hora_final_vulcanizacao] - 320 / 1440 RETURN DATE ( YEAR ( __fS6 ), MONTH ( __fS6 ), DAY ( __fS6 ) ),
                    "@T", VAR __mS6 = HOUR ( ficha_producao[data_hora_final_vulcanizacao] ) * 60 + MINUTE ( ficha_producao[data_hora_final_vulcanizacao] ) RETURN IF ( __mS6 >= 320 && __mS6 < 837, 1, IF ( __mS6 >= 837 && __mS6 < 1340, 2, 3 ) ),
                    "@Q", VAR __qS6 = ficha_producao[quantidade_vulcanizacao] RETURN IF ( __qS6 > 2000, BLANK (), __qS6 ),
                    "@M", VAR __mqS6 = UPPER ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( ficha_producao[Trançadeira], ".", "" ), "-", "" ), " ", "" ), "_", "" ) ) RETURN IF ( __mqS6 IN { "SPIRAL", "TE01", "TE0" }, "SPIRAL", __mqS6 ),
                    "@Op", SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(UPPER ( ficha_producao[operador_vulcanizacao] ),"Á","A"),"À","A"),"Â","A"),"Ã","A"),"Ä","A"),"É","E"),"È","E"),"Ê","E"),"Ë","E"),"Í","I"),"Ì","I"),"Î","I"),"Ï","I"),"Ó","O"),"Ò","O"),"Ô","O"),"Õ","O"),"Ö","O"),"Ú","U"),"Ù","U"),"Û","U"),"Ü","U"),"Ç","C"),"Ñ","N"),".",""),",",""),"-",""),"_",""),"/","|")
                ),
                [@Dia] IN __Datas
            ),
            FILTER (
                SELECTCOLUMNS (
                    FILTER ( ALL ( ficha_producao ), NOT ISBLANK ( ficha_producao[data_hora_final_debandagem] ) ),
                    "@E", 7,
                    "@Dia", VAR __fS7 = ficha_producao[data_hora_final_debandagem] - 320 / 1440 RETURN DATE ( YEAR ( __fS7 ), MONTH ( __fS7 ), DAY ( __fS7 ) ),
                    "@T", VAR __mS7 = HOUR ( ficha_producao[data_hora_final_debandagem] ) * 60 + MINUTE ( ficha_producao[data_hora_final_debandagem] ) RETURN IF ( __mS7 >= 320 && __mS7 < 837, 1, IF ( __mS7 >= 837 && __mS7 < 1340, 2, 3 ) ),
                    "@Q", VAR __qS7 = ficha_producao[quantidade_debandagem] RETURN IF ( __qS7 > 2000, BLANK (), __qS7 ),
                    "@M", VAR __mqS7 = UPPER ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( ficha_producao[Trançadeira], ".", "" ), "-", "" ), " ", "" ), "_", "" ) ) RETURN IF ( __mqS7 IN { "SPIRAL", "TE01", "TE0" }, "SPIRAL", __mqS7 ),
                    "@Op", SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(UPPER ( ficha_producao[operador_debandagem] ),"Á","A"),"À","A"),"Â","A"),"Ã","A"),"Ä","A"),"É","E"),"È","E"),"Ê","E"),"Ë","E"),"Í","I"),"Ì","I"),"Î","I"),"Ï","I"),"Ó","O"),"Ò","O"),"Ô","O"),"Õ","O"),"Ö","O"),"Ú","U"),"Ù","U"),"Û","U"),"Ü","U"),"Ç","C"),"Ñ","N"),".",""),",",""),"-",""),"_",""),"/","|")
                ),
                [@Dia] IN __Datas
            ),
            FILTER (
                SELECTCOLUMNS (
                    FILTER ( ALL ( ficha_producao ), NOT ISBLANK ( ficha_producao[data_hora_final_extracao] ) ),
                    "@E", 8,
                    "@Dia", VAR __fS8 = ficha_producao[data_hora_final_extracao] - 320 / 1440 RETURN DATE ( YEAR ( __fS8 ), MONTH ( __fS8 ), DAY ( __fS8 ) ),
                    "@T", VAR __mS8 = HOUR ( ficha_producao[data_hora_final_extracao] ) * 60 + MINUTE ( ficha_producao[data_hora_final_extracao] ) RETURN IF ( __mS8 >= 320 && __mS8 < 837, 1, IF ( __mS8 >= 837 && __mS8 < 1340, 2, 3 ) ),
                    "@Q", VAR __qS8 = ficha_producao[quantidade_extracao] RETURN IF ( __qS8 > 2000, BLANK (), __qS8 ),
                    "@M", VAR __mqS8 = UPPER ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( ficha_producao[Trançadeira], ".", "" ), "-", "" ), " ", "" ), "_", "" ) ) RETURN IF ( __mqS8 IN { "SPIRAL", "TE01", "TE0" }, "SPIRAL", __mqS8 ),
                    "@Op", SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(UPPER ( ficha_producao[operador_extracao] ),"Á","A"),"À","A"),"Â","A"),"Ã","A"),"Ä","A"),"É","E"),"È","E"),"Ê","E"),"Ë","E"),"Í","I"),"Ì","I"),"Î","I"),"Ï","I"),"Ó","O"),"Ò","O"),"Ô","O"),"Õ","O"),"Ö","O"),"Ú","U"),"Ù","U"),"Û","U"),"Ü","U"),"Ç","C"),"Ñ","N"),".",""),",",""),"-",""),"_",""),"/","|")
                ),
                [@Dia] IN __Datas
            )
        )
        VAR __BTr = FILTER ( __B, [@E] = 3 )
        VAR __DiasCom = DISTINCT ( SELECTCOLUMNS ( __B, "@Dia", [@Dia] ) )
        VAR __DiasProd =
            FILTER (
                __DiasCom,
                VAR __dProd = [@Dia]
                RETURN __UmDia || SUMX ( FILTER ( __BTr, [@Dia] = __dProd ), [@Q] ) >= 3000
            )
        VAR __nD = COUNTROWS ( __DiasProd )
        VAR __LA = FILTER ( __B, ( NOT __FT || [@T] IN __Turnos ) && ( NOT __FM || [@M] IN __Maqs ) )
        VAR __LP = FILTER ( __LA, [@Dia] IN __DiasProd )
        VAR __M1 = DIVIDE ( SUMX ( FILTER ( __LP, [@E] = 1 ), [@Q] ), __nD )
        VAR __M2 = DIVIDE ( SUMX ( FILTER ( __LP, [@E] = 2 ), [@Q] ), __nD )
        VAR __M3 = DIVIDE ( SUMX ( FILTER ( __LP, [@E] = 3 ), [@Q] ), __nD )
        VAR __M4 = DIVIDE ( SUMX ( FILTER ( __LP, [@E] = 4 ), [@Q] ), __nD )
        VAR __M5 = DIVIDE ( SUMX ( FILTER ( __LP, [@E] = 5 ), [@Q] ), __nD )
        VAR __M6 = DIVIDE ( SUMX ( FILTER ( __LP, [@E] = 6 ), [@Q] ), __nD )
        VAR __M7 = DIVIDE ( SUMX ( FILTER ( __LP, [@E] = 7 ), [@Q] ), __nD )
        VAR __M8 = DIVIDE ( SUMX ( FILTER ( __LP, [@E] = 8 ), [@Q] ), __nD )
        VAR __P =
            DISTINCT (
                SELECTCOLUMNS (
                    FILTER (
                        GENERATE (
                            FILTER ( __LP, [@Op] <> "" ),
                            VAR __sOp = [@Op]
                            RETURN SELECTCOLUMNS ( GENERATESERIES ( 1, PATHLENGTH ( __sOp ) ), "@Pe", TRIM ( PATHITEM ( __sOp, [Value] ) ) )
                        ),
                        [@Pe] <> ""
                    ),
                    "@E", [@E], "@Dia", [@Dia], "@Pe", [@Pe]
                )
            )
        VAR __Pp1 = DIVIDE ( COUNTROWS ( FILTER ( __P, [@E] = 1 ) ), __nD )
        VAR __K1 = DIVIDE ( __Pp1, DIVIDE ( __M1, 1000 ) )
        VAR __Pp2 = DIVIDE ( COUNTROWS ( FILTER ( __P, [@E] = 2 ) ), __nD )
        VAR __K2 = DIVIDE ( __Pp2, DIVIDE ( __M2, 1000 ) )
        VAR __Pp3 = DIVIDE ( COUNTROWS ( FILTER ( __P, [@E] = 3 ) ), __nD )
        VAR __K3 = DIVIDE ( __Pp3, DIVIDE ( __M3, 1000 ) )
        VAR __Pp4 = DIVIDE ( COUNTROWS ( FILTER ( __P, [@E] = 4 ) ), __nD )
        VAR __K4 = DIVIDE ( __Pp4, DIVIDE ( __M4, 1000 ) )
        VAR __Pp5 = DIVIDE ( COUNTROWS ( FILTER ( __P, [@E] = 5 ) ), __nD )
        VAR __K5 = DIVIDE ( __Pp5, DIVIDE ( __M5, 1000 ) )
        VAR __Pp6 = DIVIDE ( COUNTROWS ( FILTER ( __P, [@E] = 6 ) ), __nD )
        VAR __K6 = DIVIDE ( __Pp6, DIVIDE ( __M6, 1000 ) )
        VAR __Pp7 = DIVIDE ( COUNTROWS ( FILTER ( __P, [@E] = 7 ) ), __nD )
        VAR __K7 = DIVIDE ( __Pp7, DIVIDE ( __M7, 1000 ) )
        VAR __Pp8 = DIVIDE ( COUNTROWS ( FILTER ( __P, [@E] = 8 ) ), __nD )
        VAR __K8 = DIVIDE ( __Pp8, DIVIDE ( __M8, 1000 ) )
        VAR __Kt = { ( 1, __K1 ), ( 2, __K2 ), ( 3, __K3 ), ( 4, __K4 ), ( 5, __K5 ), ( 6, __K6 ), ( 7, __K7 ), ( 8, __K8 ) }
        VAR __Kv = FILTER ( __Kt, NOT ISBLANK ( [Value2] ) )
        VAR __KMedia = AVERAGEX ( __Kv, [Value2] )
        VAR __KMaior = MAXX ( __Kv, [Value2] )
        VAR __Vt = { ( 1, __M1 ), ( 2, __M2 ), ( 3, __M3 ), ( 4, __M4 ), ( 5, __M5 ), ( 6, __M6 ), ( 7, __M7 ), ( 8, __M8 ) }
        VAR __iV = MAXX ( TOPN ( 1, FILTER ( __Vt, [Value2] > 0 ), [Value2], ASC, [Value1], ASC ), [Value1] )
        VAR __iC = MAXX ( TOPN ( 1, FILTER ( __Kt, [Value2] > 0 ), [Value2], DESC, [Value1], ASC ), [Value1] )
        VAR __MenorV = MINX ( FILTER ( __Vt, [Value2] > 0 ), [Value2] )
        RETURN
            IF ( NOT ISBLANK ( __iV ), SWITCH ( __iV, 1, "Solda de mandril", 2, "Tubo", 3, __NomeTr, 4, "Cobertura", 5, "Bandagem", 6, "Vulcanização", 7, "Debandagem", 8, "Cabine (teste)" ) & " (" & FORMAT ( __MenorV, "#,0" ) & " m/dia)" )

// 1) Por etapa, todos os turnos, todas as máquinas
EVALUATE
CALCULATETABLE (
        VAR __Datas = CALCULATETABLE ( VALUES ( dCalendario[Date] ), REMOVEFILTERS ( fHoraHora[Turno] ), REMOVEFILTERS ( ficha_producao[Trançadeira] ) )
        VAR __UmDia = COUNTROWS ( __Datas ) = 1
        VAR __FT = ISFILTERED ( fHoraHora[Turno] )
        VAR __Turnos =
            FILTER (
                SELECTCOLUMNS (
                    CALCULATETABLE ( VALUES ( fHoraHora[Turno] ), REMOVEFILTERS ( dCalendario ) ),
                    "@T", VAR __tTx = fHoraHora[Turno] & "" VAR __tP1 = SEARCH ( "1", __tTx, 1, 999 ) VAR __tP2 = SEARCH ( "2", __tTx, 1, 999 ) VAR __tP3 = SEARCH ( "3", __tTx, 1, 999 ) VAR __tPm = MIN ( MIN ( __tP1, __tP2 ), __tP3 ) RETURN IF ( __tPm = 999, BLANK (), IF ( __tPm = __tP1, 1, IF ( __tPm = __tP2, 2, 3 ) ) )
                ),
                NOT ISBLANK ( [@T] )
            )
        VAR __FM = ISFILTERED ( ficha_producao[Trançadeira] )
        VAR __Maqs = DISTINCT ( SELECTCOLUMNS ( FILTERS ( ficha_producao[Trançadeira] ), "@M", VAR __mqSel = UPPER ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( ficha_producao[Trançadeira], ".", "" ), "-", "" ), " ", "" ), "_", "" ) ) RETURN IF ( __mqSel IN { "SPIRAL", "TE01", "TE0" }, "SPIRAL", __mqSel ) ) )
        VAR __MaqTxt = CONCATENATEX ( FILTER ( __Maqs, [@M] <> "" ), [@M], ", ", [@M], ASC )
        VAR __TemSp = "SPIRAL" IN __Maqs
        VAR __TemBr = NOT ISEMPTY ( FILTER ( __Maqs, [@M] <> "SPIRAL" ) )
        VAR __NomeTr = IF ( NOT __FM || ( __TemSp && __TemBr ), "Trançagem + Espiral", IF ( __TemSp, "Espiral", "Trançagem" ) )
        VAR __B =
        UNION (
            FILTER (
                SELECTCOLUMNS (
                    FILTER ( ALL ( ficha_producao ), NOT ISBLANK ( ficha_producao[data_hora_final_mandril] ) ),
                    "@E", 1,
                    "@Dia", VAR __fS1 = ficha_producao[data_hora_final_mandril] - 320 / 1440 RETURN DATE ( YEAR ( __fS1 ), MONTH ( __fS1 ), DAY ( __fS1 ) ),
                    "@T", VAR __mS1 = HOUR ( ficha_producao[data_hora_final_mandril] ) * 60 + MINUTE ( ficha_producao[data_hora_final_mandril] ) RETURN IF ( __mS1 >= 320 && __mS1 < 837, 1, IF ( __mS1 >= 837 && __mS1 < 1340, 2, 3 ) ),
                    "@Q", VAR __qS1 = ficha_producao[quantidade_mandril] RETURN IF ( __qS1 > 2000, BLANK (), __qS1 ),
                    "@M", VAR __mqS1 = UPPER ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( ficha_producao[Trançadeira], ".", "" ), "-", "" ), " ", "" ), "_", "" ) ) RETURN IF ( __mqS1 IN { "SPIRAL", "TE01", "TE0" }, "SPIRAL", __mqS1 ),
                    "@Op", SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(UPPER ( ficha_producao[operador_mandril] ),"Á","A"),"À","A"),"Â","A"),"Ã","A"),"Ä","A"),"É","E"),"È","E"),"Ê","E"),"Ë","E"),"Í","I"),"Ì","I"),"Î","I"),"Ï","I"),"Ó","O"),"Ò","O"),"Ô","O"),"Õ","O"),"Ö","O"),"Ú","U"),"Ù","U"),"Û","U"),"Ü","U"),"Ç","C"),"Ñ","N"),".",""),",",""),"-",""),"_",""),"/","|"),
                    "@Car", VAR __cS1Car = ficha_producao[quantidade_mandril] VAR __cvS1Car = IF ( __cS1Car > 2000, BLANK (), __cS1Car ) VAR __mcS1Car = SWITCH ( ficha_producao[Bitola], 4, 800, 6, 680, 8, 680, 10, 460, 12, 400, 16, 250 ) RETURN DIVIDE ( __cvS1Car, __mcS1Car ),
                    "@Cob", VAR __cS1Cob = ficha_producao[quantidade_mandril] VAR __cvS1Cob = IF ( __cS1Cob > 2000, BLANK (), __cS1Cob ) VAR __mcS1Cob = SWITCH ( ficha_producao[Bitola], 4, 800, 6, 680, 8, 680, 10, 460, 12, 400, 16, 250 ) RETURN IF ( NOT ISBLANK ( __mcS1Cob ), __cvS1Cob )
                ),
                [@Dia] IN __Datas
            ),
            FILTER (
                SELECTCOLUMNS (
                    FILTER ( ALL ( ficha_producao ), NOT ISBLANK ( ficha_producao[data_hora_final_tubo] ) ),
                    "@E", 2,
                    "@Dia", VAR __fS2 = ficha_producao[data_hora_final_tubo] - 320 / 1440 RETURN DATE ( YEAR ( __fS2 ), MONTH ( __fS2 ), DAY ( __fS2 ) ),
                    "@T", VAR __mS2 = HOUR ( ficha_producao[data_hora_final_tubo] ) * 60 + MINUTE ( ficha_producao[data_hora_final_tubo] ) RETURN IF ( __mS2 >= 320 && __mS2 < 837, 1, IF ( __mS2 >= 837 && __mS2 < 1340, 2, 3 ) ),
                    "@Q", VAR __qS2 = ficha_producao[quantidade_tubo] RETURN IF ( __qS2 > 2000, BLANK (), __qS2 ),
                    "@M", VAR __mqS2 = UPPER ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( ficha_producao[Trançadeira], ".", "" ), "-", "" ), " ", "" ), "_", "" ) ) RETURN IF ( __mqS2 IN { "SPIRAL", "TE01", "TE0" }, "SPIRAL", __mqS2 ),
                    "@Op", SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(UPPER ( ficha_producao[operador_tubo] ),"Á","A"),"À","A"),"Â","A"),"Ã","A"),"Ä","A"),"É","E"),"È","E"),"Ê","E"),"Ë","E"),"Í","I"),"Ì","I"),"Î","I"),"Ï","I"),"Ó","O"),"Ò","O"),"Ô","O"),"Õ","O"),"Ö","O"),"Ú","U"),"Ù","U"),"Û","U"),"Ü","U"),"Ç","C"),"Ñ","N"),".",""),",",""),"-",""),"_",""),"/","|"),
                    "@Car", VAR __cS2Car = ficha_producao[quantidade_tubo] VAR __cvS2Car = IF ( __cS2Car > 2000, BLANK (), __cS2Car ) VAR __mcS2Car = SWITCH ( ficha_producao[Bitola], 4, 800, 6, 680, 8, 680, 10, 460, 12, 400, 16, 250 ) RETURN DIVIDE ( __cvS2Car, __mcS2Car ),
                    "@Cob", VAR __cS2Cob = ficha_producao[quantidade_tubo] VAR __cvS2Cob = IF ( __cS2Cob > 2000, BLANK (), __cS2Cob ) VAR __mcS2Cob = SWITCH ( ficha_producao[Bitola], 4, 800, 6, 680, 8, 680, 10, 460, 12, 400, 16, 250 ) RETURN IF ( NOT ISBLANK ( __mcS2Cob ), __cvS2Cob )
                ),
                [@Dia] IN __Datas
            ),
            FILTER (
                SELECTCOLUMNS (
                    FILTER ( ALL ( ficha_producao ), NOT ISBLANK ( ficha_producao[data_hora_final_trancadeira] ) ),
                    "@E", 3,
                    "@Dia", VAR __fS3 = ficha_producao[data_hora_final_trancadeira] - 320 / 1440 RETURN DATE ( YEAR ( __fS3 ), MONTH ( __fS3 ), DAY ( __fS3 ) ),
                    "@T", VAR __mS3 = HOUR ( ficha_producao[data_hora_final_trancadeira] ) * 60 + MINUTE ( ficha_producao[data_hora_final_trancadeira] ) RETURN IF ( __mS3 >= 320 && __mS3 < 837, 1, IF ( __mS3 >= 837 && __mS3 < 1340, 2, 3 ) ),
                    "@Q", VAR __qS3 = ficha_producao[quantidade_trancagem] RETURN IF ( __qS3 > 2000, BLANK (), __qS3 ),
                    "@M", VAR __mqS3 = UPPER ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( ficha_producao[Trançadeira], ".", "" ), "-", "" ), " ", "" ), "_", "" ) ) RETURN IF ( __mqS3 IN { "SPIRAL", "TE01", "TE0" }, "SPIRAL", __mqS3 ),
                    "@Op", SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(UPPER ( ficha_producao[operador_trancagem] ),"Á","A"),"À","A"),"Â","A"),"Ã","A"),"Ä","A"),"É","E"),"È","E"),"Ê","E"),"Ë","E"),"Í","I"),"Ì","I"),"Î","I"),"Ï","I"),"Ó","O"),"Ò","O"),"Ô","O"),"Õ","O"),"Ö","O"),"Ú","U"),"Ù","U"),"Û","U"),"Ü","U"),"Ç","C"),"Ñ","N"),".",""),",",""),"-",""),"_",""),"/","|"),
                    "@Car", VAR __cS3Car = ficha_producao[quantidade_trancagem] VAR __cvS3Car = IF ( __cS3Car > 2000, BLANK (), __cS3Car ) VAR __mcS3Car = SWITCH ( ficha_producao[Bitola], 4, 800, 6, 680, 8, 680, 10, 460, 12, 400, 16, 250 ) RETURN DIVIDE ( __cvS3Car, __mcS3Car ),
                    "@Cob", VAR __cS3Cob = ficha_producao[quantidade_trancagem] VAR __cvS3Cob = IF ( __cS3Cob > 2000, BLANK (), __cS3Cob ) VAR __mcS3Cob = SWITCH ( ficha_producao[Bitola], 4, 800, 6, 680, 8, 680, 10, 460, 12, 400, 16, 250 ) RETURN IF ( NOT ISBLANK ( __mcS3Cob ), __cvS3Cob )
                ),
                [@Dia] IN __Datas
            ),
            FILTER (
                SELECTCOLUMNS (
                    FILTER ( ALL ( ficha_producao ), NOT ISBLANK ( ficha_producao[data_hora_final_cobertura] ) ),
                    "@E", 4,
                    "@Dia", VAR __fS4 = ficha_producao[data_hora_final_cobertura] - 320 / 1440 RETURN DATE ( YEAR ( __fS4 ), MONTH ( __fS4 ), DAY ( __fS4 ) ),
                    "@T", VAR __mS4 = HOUR ( ficha_producao[data_hora_final_cobertura] ) * 60 + MINUTE ( ficha_producao[data_hora_final_cobertura] ) RETURN IF ( __mS4 >= 320 && __mS4 < 837, 1, IF ( __mS4 >= 837 && __mS4 < 1340, 2, 3 ) ),
                    "@Q", VAR __qS4 = ficha_producao[quantidade_cobertura] RETURN IF ( __qS4 > 2000, BLANK (), __qS4 ),
                    "@M", VAR __mqS4 = UPPER ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( ficha_producao[Trançadeira], ".", "" ), "-", "" ), " ", "" ), "_", "" ) ) RETURN IF ( __mqS4 IN { "SPIRAL", "TE01", "TE0" }, "SPIRAL", __mqS4 ),
                    "@Op", SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(UPPER ( ficha_producao[operador_cobertura] ),"Á","A"),"À","A"),"Â","A"),"Ã","A"),"Ä","A"),"É","E"),"È","E"),"Ê","E"),"Ë","E"),"Í","I"),"Ì","I"),"Î","I"),"Ï","I"),"Ó","O"),"Ò","O"),"Ô","O"),"Õ","O"),"Ö","O"),"Ú","U"),"Ù","U"),"Û","U"),"Ü","U"),"Ç","C"),"Ñ","N"),".",""),",",""),"-",""),"_",""),"/","|"),
                    "@Car", VAR __cS4Car = ficha_producao[quantidade_cobertura] VAR __cvS4Car = IF ( __cS4Car > 2000, BLANK (), __cS4Car ) VAR __mcS4Car = SWITCH ( ficha_producao[Bitola], 4, 800, 6, 680, 8, 680, 10, 460, 12, 400, 16, 250 ) RETURN DIVIDE ( __cvS4Car, __mcS4Car ),
                    "@Cob", VAR __cS4Cob = ficha_producao[quantidade_cobertura] VAR __cvS4Cob = IF ( __cS4Cob > 2000, BLANK (), __cS4Cob ) VAR __mcS4Cob = SWITCH ( ficha_producao[Bitola], 4, 800, 6, 680, 8, 680, 10, 460, 12, 400, 16, 250 ) RETURN IF ( NOT ISBLANK ( __mcS4Cob ), __cvS4Cob )
                ),
                [@Dia] IN __Datas
            ),
            FILTER (
                SELECTCOLUMNS (
                    FILTER ( ALL ( ficha_producao ), NOT ISBLANK ( ficha_producao[data_hora_final_bandagem] ) ),
                    "@E", 5,
                    "@Dia", VAR __fS5 = ficha_producao[data_hora_final_bandagem] - 320 / 1440 RETURN DATE ( YEAR ( __fS5 ), MONTH ( __fS5 ), DAY ( __fS5 ) ),
                    "@T", VAR __mS5 = HOUR ( ficha_producao[data_hora_final_bandagem] ) * 60 + MINUTE ( ficha_producao[data_hora_final_bandagem] ) RETURN IF ( __mS5 >= 320 && __mS5 < 837, 1, IF ( __mS5 >= 837 && __mS5 < 1340, 2, 3 ) ),
                    "@Q", VAR __qS5 = ficha_producao[quantidade_bandagem] RETURN IF ( __qS5 > 2000, BLANK (), __qS5 ),
                    "@M", VAR __mqS5 = UPPER ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( ficha_producao[Trançadeira], ".", "" ), "-", "" ), " ", "" ), "_", "" ) ) RETURN IF ( __mqS5 IN { "SPIRAL", "TE01", "TE0" }, "SPIRAL", __mqS5 ),
                    "@Op", SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(UPPER ( ficha_producao[operador_bandagem] ),"Á","A"),"À","A"),"Â","A"),"Ã","A"),"Ä","A"),"É","E"),"È","E"),"Ê","E"),"Ë","E"),"Í","I"),"Ì","I"),"Î","I"),"Ï","I"),"Ó","O"),"Ò","O"),"Ô","O"),"Õ","O"),"Ö","O"),"Ú","U"),"Ù","U"),"Û","U"),"Ü","U"),"Ç","C"),"Ñ","N"),".",""),",",""),"-",""),"_",""),"/","|"),
                    "@Car", VAR __cS5Car = ficha_producao[quantidade_bandagem] VAR __cvS5Car = IF ( __cS5Car > 2000, BLANK (), __cS5Car ) VAR __mcS5Car = SWITCH ( ficha_producao[Bitola], 4, 800, 6, 680, 8, 680, 10, 460, 12, 400, 16, 250 ) RETURN DIVIDE ( __cvS5Car, __mcS5Car ),
                    "@Cob", VAR __cS5Cob = ficha_producao[quantidade_bandagem] VAR __cvS5Cob = IF ( __cS5Cob > 2000, BLANK (), __cS5Cob ) VAR __mcS5Cob = SWITCH ( ficha_producao[Bitola], 4, 800, 6, 680, 8, 680, 10, 460, 12, 400, 16, 250 ) RETURN IF ( NOT ISBLANK ( __mcS5Cob ), __cvS5Cob )
                ),
                [@Dia] IN __Datas
            ),
            FILTER (
                SELECTCOLUMNS (
                    FILTER ( ALL ( ficha_producao ), NOT ISBLANK ( ficha_producao[data_hora_final_vulcanizacao] ) ),
                    "@E", 6,
                    "@Dia", VAR __fS6 = ficha_producao[data_hora_final_vulcanizacao] - 320 / 1440 RETURN DATE ( YEAR ( __fS6 ), MONTH ( __fS6 ), DAY ( __fS6 ) ),
                    "@T", VAR __mS6 = HOUR ( ficha_producao[data_hora_final_vulcanizacao] ) * 60 + MINUTE ( ficha_producao[data_hora_final_vulcanizacao] ) RETURN IF ( __mS6 >= 320 && __mS6 < 837, 1, IF ( __mS6 >= 837 && __mS6 < 1340, 2, 3 ) ),
                    "@Q", VAR __qS6 = ficha_producao[quantidade_vulcanizacao] RETURN IF ( __qS6 > 2000, BLANK (), __qS6 ),
                    "@M", VAR __mqS6 = UPPER ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( ficha_producao[Trançadeira], ".", "" ), "-", "" ), " ", "" ), "_", "" ) ) RETURN IF ( __mqS6 IN { "SPIRAL", "TE01", "TE0" }, "SPIRAL", __mqS6 ),
                    "@Op", SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(UPPER ( ficha_producao[operador_vulcanizacao] ),"Á","A"),"À","A"),"Â","A"),"Ã","A"),"Ä","A"),"É","E"),"È","E"),"Ê","E"),"Ë","E"),"Í","I"),"Ì","I"),"Î","I"),"Ï","I"),"Ó","O"),"Ò","O"),"Ô","O"),"Õ","O"),"Ö","O"),"Ú","U"),"Ù","U"),"Û","U"),"Ü","U"),"Ç","C"),"Ñ","N"),".",""),",",""),"-",""),"_",""),"/","|"),
                    "@Car", VAR __cS6Car = ficha_producao[quantidade_vulcanizacao] VAR __cvS6Car = IF ( __cS6Car > 2000, BLANK (), __cS6Car ) VAR __mcS6Car = SWITCH ( ficha_producao[Bitola], 4, 800, 6, 680, 8, 680, 10, 460, 12, 400, 16, 250 ) RETURN DIVIDE ( __cvS6Car, __mcS6Car ),
                    "@Cob", VAR __cS6Cob = ficha_producao[quantidade_vulcanizacao] VAR __cvS6Cob = IF ( __cS6Cob > 2000, BLANK (), __cS6Cob ) VAR __mcS6Cob = SWITCH ( ficha_producao[Bitola], 4, 800, 6, 680, 8, 680, 10, 460, 12, 400, 16, 250 ) RETURN IF ( NOT ISBLANK ( __mcS6Cob ), __cvS6Cob )
                ),
                [@Dia] IN __Datas
            ),
            FILTER (
                SELECTCOLUMNS (
                    FILTER ( ALL ( ficha_producao ), NOT ISBLANK ( ficha_producao[data_hora_final_debandagem] ) ),
                    "@E", 7,
                    "@Dia", VAR __fS7 = ficha_producao[data_hora_final_debandagem] - 320 / 1440 RETURN DATE ( YEAR ( __fS7 ), MONTH ( __fS7 ), DAY ( __fS7 ) ),
                    "@T", VAR __mS7 = HOUR ( ficha_producao[data_hora_final_debandagem] ) * 60 + MINUTE ( ficha_producao[data_hora_final_debandagem] ) RETURN IF ( __mS7 >= 320 && __mS7 < 837, 1, IF ( __mS7 >= 837 && __mS7 < 1340, 2, 3 ) ),
                    "@Q", VAR __qS7 = ficha_producao[quantidade_debandagem] RETURN IF ( __qS7 > 2000, BLANK (), __qS7 ),
                    "@M", VAR __mqS7 = UPPER ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( ficha_producao[Trançadeira], ".", "" ), "-", "" ), " ", "" ), "_", "" ) ) RETURN IF ( __mqS7 IN { "SPIRAL", "TE01", "TE0" }, "SPIRAL", __mqS7 ),
                    "@Op", SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(UPPER ( ficha_producao[operador_debandagem] ),"Á","A"),"À","A"),"Â","A"),"Ã","A"),"Ä","A"),"É","E"),"È","E"),"Ê","E"),"Ë","E"),"Í","I"),"Ì","I"),"Î","I"),"Ï","I"),"Ó","O"),"Ò","O"),"Ô","O"),"Õ","O"),"Ö","O"),"Ú","U"),"Ù","U"),"Û","U"),"Ü","U"),"Ç","C"),"Ñ","N"),".",""),",",""),"-",""),"_",""),"/","|"),
                    "@Car", VAR __cS7Car = ficha_producao[quantidade_debandagem] VAR __cvS7Car = IF ( __cS7Car > 2000, BLANK (), __cS7Car ) VAR __mcS7Car = SWITCH ( ficha_producao[Bitola], 4, 800, 6, 680, 8, 680, 10, 460, 12, 400, 16, 250 ) RETURN DIVIDE ( __cvS7Car, __mcS7Car ),
                    "@Cob", VAR __cS7Cob = ficha_producao[quantidade_debandagem] VAR __cvS7Cob = IF ( __cS7Cob > 2000, BLANK (), __cS7Cob ) VAR __mcS7Cob = SWITCH ( ficha_producao[Bitola], 4, 800, 6, 680, 8, 680, 10, 460, 12, 400, 16, 250 ) RETURN IF ( NOT ISBLANK ( __mcS7Cob ), __cvS7Cob )
                ),
                [@Dia] IN __Datas
            ),
            FILTER (
                SELECTCOLUMNS (
                    FILTER ( ALL ( ficha_producao ), NOT ISBLANK ( ficha_producao[data_hora_final_extracao] ) ),
                    "@E", 8,
                    "@Dia", VAR __fS8 = ficha_producao[data_hora_final_extracao] - 320 / 1440 RETURN DATE ( YEAR ( __fS8 ), MONTH ( __fS8 ), DAY ( __fS8 ) ),
                    "@T", VAR __mS8 = HOUR ( ficha_producao[data_hora_final_extracao] ) * 60 + MINUTE ( ficha_producao[data_hora_final_extracao] ) RETURN IF ( __mS8 >= 320 && __mS8 < 837, 1, IF ( __mS8 >= 837 && __mS8 < 1340, 2, 3 ) ),
                    "@Q", VAR __qS8 = ficha_producao[quantidade_extracao] RETURN IF ( __qS8 > 2000, BLANK (), __qS8 ),
                    "@M", VAR __mqS8 = UPPER ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( ficha_producao[Trançadeira], ".", "" ), "-", "" ), " ", "" ), "_", "" ) ) RETURN IF ( __mqS8 IN { "SPIRAL", "TE01", "TE0" }, "SPIRAL", __mqS8 ),
                    "@Op", SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(UPPER ( ficha_producao[operador_extracao] ),"Á","A"),"À","A"),"Â","A"),"Ã","A"),"Ä","A"),"É","E"),"È","E"),"Ê","E"),"Ë","E"),"Í","I"),"Ì","I"),"Î","I"),"Ï","I"),"Ó","O"),"Ò","O"),"Ô","O"),"Õ","O"),"Ö","O"),"Ú","U"),"Ù","U"),"Û","U"),"Ü","U"),"Ç","C"),"Ñ","N"),".",""),",",""),"-",""),"_",""),"/","|"),
                    "@Car", VAR __cS8Car = ficha_producao[quantidade_extracao] VAR __cvS8Car = IF ( __cS8Car > 2000, BLANK (), __cS8Car ) VAR __mcS8Car = SWITCH ( ficha_producao[Bitola], 4, 800, 6, 680, 8, 680, 10, 460, 12, 400, 16, 250 ) RETURN DIVIDE ( __cvS8Car, __mcS8Car ),
                    "@Cob", VAR __cS8Cob = ficha_producao[quantidade_extracao] VAR __cvS8Cob = IF ( __cS8Cob > 2000, BLANK (), __cS8Cob ) VAR __mcS8Cob = SWITCH ( ficha_producao[Bitola], 4, 800, 6, 680, 8, 680, 10, 460, 12, 400, 16, 250 ) RETURN IF ( NOT ISBLANK ( __mcS8Cob ), __cvS8Cob )
                ),
                [@Dia] IN __Datas
            )
        )
        VAR __BTr = FILTER ( __B, [@E] = 3 )
        VAR __DiasCom = DISTINCT ( SELECTCOLUMNS ( __B, "@Dia", [@Dia] ) )
        VAR __DiasProd =
            FILTER (
                __DiasCom,
                VAR __dProd = [@Dia]
                RETURN __UmDia || SUMX ( FILTER ( __BTr, [@Dia] = __dProd ), [@Q] ) >= 3000
            )
        VAR __nD = COUNTROWS ( __DiasProd )
        VAR __LA = FILTER ( __B, ( NOT __FT || [@T] IN __Turnos ) && ( NOT __FM || [@M] IN __Maqs ) )
        VAR __LP = FILTER ( __LA, [@Dia] IN __DiasProd )
        VAR __M1 = DIVIDE ( SUMX ( FILTER ( __LP, [@E] = 1 ), [@Q] ), __nD )
        VAR __M2 = DIVIDE ( SUMX ( FILTER ( __LP, [@E] = 2 ), [@Q] ), __nD )
        VAR __M3 = DIVIDE ( SUMX ( FILTER ( __LP, [@E] = 3 ), [@Q] ), __nD )
        VAR __M4 = DIVIDE ( SUMX ( FILTER ( __LP, [@E] = 4 ), [@Q] ), __nD )
        VAR __M5 = DIVIDE ( SUMX ( FILTER ( __LP, [@E] = 5 ), [@Q] ), __nD )
        VAR __M6 = DIVIDE ( SUMX ( FILTER ( __LP, [@E] = 6 ), [@Q] ), __nD )
        VAR __M7 = DIVIDE ( SUMX ( FILTER ( __LP, [@E] = 7 ), [@Q] ), __nD )
        VAR __M8 = DIVIDE ( SUMX ( FILTER ( __LP, [@E] = 8 ), [@Q] ), __nD )
        VAR __P =
            DISTINCT (
                SELECTCOLUMNS (
                    FILTER (
                        GENERATE (
                            FILTER ( __LP, [@Op] <> "" ),
                            VAR __sOp = [@Op]
                            RETURN SELECTCOLUMNS ( GENERATESERIES ( 1, PATHLENGTH ( __sOp ) ), "@Pe", TRIM ( PATHITEM ( __sOp, [Value] ) ) )
                        ),
                        [@Pe] <> ""
                    ),
                    "@E", [@E], "@Dia", [@Dia], "@Pe", [@Pe]
                )
            )
        VAR __Pp1 = DIVIDE ( COUNTROWS ( FILTER ( __P, [@E] = 1 ) ), __nD )
        VAR __K1 = DIVIDE ( __Pp1, DIVIDE ( __M1, 1000 ) )
        VAR __Pp2 = DIVIDE ( COUNTROWS ( FILTER ( __P, [@E] = 2 ) ), __nD )
        VAR __K2 = DIVIDE ( __Pp2, DIVIDE ( __M2, 1000 ) )
        VAR __Pp3 = DIVIDE ( COUNTROWS ( FILTER ( __P, [@E] = 3 ) ), __nD )
        VAR __K3 = DIVIDE ( __Pp3, DIVIDE ( __M3, 1000 ) )
        VAR __Pp4 = DIVIDE ( COUNTROWS ( FILTER ( __P, [@E] = 4 ) ), __nD )
        VAR __K4 = DIVIDE ( __Pp4, DIVIDE ( __M4, 1000 ) )
        VAR __Pp5 = DIVIDE ( COUNTROWS ( FILTER ( __P, [@E] = 5 ) ), __nD )
        VAR __K5 = DIVIDE ( __Pp5, DIVIDE ( __M5, 1000 ) )
        VAR __Pp6 = DIVIDE ( COUNTROWS ( FILTER ( __P, [@E] = 6 ) ), __nD )
        VAR __K6 = DIVIDE ( __Pp6, DIVIDE ( __M6, 1000 ) )
        VAR __Pp7 = DIVIDE ( COUNTROWS ( FILTER ( __P, [@E] = 7 ) ), __nD )
        VAR __K7 = DIVIDE ( __Pp7, DIVIDE ( __M7, 1000 ) )
        VAR __Pp8 = DIVIDE ( COUNTROWS ( FILTER ( __P, [@E] = 8 ) ), __nD )
        VAR __K8 = DIVIDE ( __Pp8, DIVIDE ( __M8, 1000 ) )
        VAR __Kt = { ( 1, __K1 ), ( 2, __K2 ), ( 3, __K3 ), ( 4, __K4 ), ( 5, __K5 ), ( 6, __K6 ), ( 7, __K7 ), ( 8, __K8 ) }
        VAR __Kv = FILTER ( __Kt, NOT ISBLANK ( [Value2] ) )
        VAR __KMedia = AVERAGEX ( __Kv, [Value2] )
        VAR __KMaior = MAXX ( __Kv, [Value2] )
        VAR __C1 = DIVIDE ( SUMX ( FILTER ( __LP, [@E] = 1 ), [@Car] ), __nD )
        VAR __Cob1 = DIVIDE ( SUMX ( FILTER ( __LP, [@E] = 1 ), [@Cob] ), SUMX ( FILTER ( __LP, [@E] = 1 ), [@Q] ) )
        VAR __C2 = DIVIDE ( SUMX ( FILTER ( __LP, [@E] = 2 ), [@Car] ), __nD )
        VAR __Cob2 = DIVIDE ( SUMX ( FILTER ( __LP, [@E] = 2 ), [@Cob] ), SUMX ( FILTER ( __LP, [@E] = 2 ), [@Q] ) )
        VAR __C3 = DIVIDE ( SUMX ( FILTER ( __LP, [@E] = 3 ), [@Car] ), __nD )
        VAR __Cob3 = DIVIDE ( SUMX ( FILTER ( __LP, [@E] = 3 ), [@Cob] ), SUMX ( FILTER ( __LP, [@E] = 3 ), [@Q] ) )
        VAR __C4 = DIVIDE ( SUMX ( FILTER ( __LP, [@E] = 4 ), [@Car] ), __nD )
        VAR __Cob4 = DIVIDE ( SUMX ( FILTER ( __LP, [@E] = 4 ), [@Cob] ), SUMX ( FILTER ( __LP, [@E] = 4 ), [@Q] ) )
        VAR __C5 = DIVIDE ( SUMX ( FILTER ( __LP, [@E] = 5 ), [@Car] ), __nD )
        VAR __Cob5 = DIVIDE ( SUMX ( FILTER ( __LP, [@E] = 5 ), [@Cob] ), SUMX ( FILTER ( __LP, [@E] = 5 ), [@Q] ) )
        VAR __C6 = DIVIDE ( SUMX ( FILTER ( __LP, [@E] = 6 ), [@Car] ), __nD )
        VAR __Cob6 = DIVIDE ( SUMX ( FILTER ( __LP, [@E] = 6 ), [@Cob] ), SUMX ( FILTER ( __LP, [@E] = 6 ), [@Q] ) )
        VAR __C7 = DIVIDE ( SUMX ( FILTER ( __LP, [@E] = 7 ), [@Car] ), __nD )
        VAR __Cob7 = DIVIDE ( SUMX ( FILTER ( __LP, [@E] = 7 ), [@Cob] ), SUMX ( FILTER ( __LP, [@E] = 7 ), [@Q] ) )
        VAR __C8 = DIVIDE ( SUMX ( FILTER ( __LP, [@E] = 8 ), [@Car] ), __nD )
        VAR __Cob8 = DIVIDE ( SUMX ( FILTER ( __LP, [@E] = 8 ), [@Cob] ), SUMX ( FILTER ( __LP, [@E] = 8 ), [@Q] ) )
        VAR __Vt = { ( 1, __M1 ), ( 2, __M2 ), ( 3, __M3 ), ( 4, __M4 ), ( 5, __M5 ), ( 6, __M6 ), ( 7, __M7 ), ( 8, __M8 ) }
        RETURN
            SELECTCOLUMNS (
                {
                    ( "1 Solda de mandril", __M1, __Pp1, DIVIDE ( __M1, __Pp1 ), __K1, __C1, __Cob1, DIVIDE ( __C1, __Pp1 ) ),
                    ( "2 Tubo", __M2, __Pp2, DIVIDE ( __M2, __Pp2 ), __K2, __C2, __Cob2, DIVIDE ( __C2, __Pp2 ) ),
                    ( "3 Trançagem", __M3, __Pp3, DIVIDE ( __M3, __Pp3 ), __K3, __C3, __Cob3, DIVIDE ( __C3, __Pp3 ) ),
                    ( "4 Cobertura", __M4, __Pp4, DIVIDE ( __M4, __Pp4 ), __K4, __C4, __Cob4, DIVIDE ( __C4, __Pp4 ) ),
                    ( "5 Bandagem", __M5, __Pp5, DIVIDE ( __M5, __Pp5 ), __K5, __C5, __Cob5, DIVIDE ( __C5, __Pp5 ) ),
                    ( "6 Vulcanização", __M6, __Pp6, DIVIDE ( __M6, __Pp6 ), __K6, __C6, __Cob6, DIVIDE ( __C6, __Pp6 ) ),
                    ( "7 Debandagem", __M7, __Pp7, DIVIDE ( __M7, __Pp7 ), __K7, __C7, __Cob7, DIVIDE ( __C7, __Pp7 ) ),
                    ( "8 Cabine (teste)", __M8, __Pp8, DIVIDE ( __M8, __Pp8 ), __K8, __C8, __Cob8, DIVIDE ( __C8, __Pp8 ) ),
                    ( "Dias produtivos", __nD, BLANK (), BLANK (), BLANK (), BLANK (), BLANK (), BLANK () )
                },
                "Etapa", [Value1], "m/dia", [Value2], "pessoas/dia", [Value3], "m/pessoa", [Value4], "pessoas/1.000 m", [Value5], "carretéis/dia", [Value6], "fatia com carretel", [Value7], "carretéis/pessoa", [Value8]
            ),
    dCalendario[Date] <= DATE ( 2026, 10, 6 )
)

// 2) Totais (as mesmas medidas dos cartões de KPI, dos gráficos e da leitura), todos os turnos e máquinas
EVALUATE
CALCULATETABLE (
    ROW (
        "Vazão Cabine (m/dia)", [Conf2 · Vazão Cabine (m/dia)],
        "Vazão Trançagem (m/dia)", [Conf2 · Vazão Trançagem (m/dia)],
        "Pessoas nas 8 Etapas", [Conf2 · Pessoas nas 8 Etapas],
        "Pessoas Trançagem (por dia)", [Conf2 · Pessoas Trançagem (por dia)],
        "Pessoas Cabine (por dia)", [Conf2 · Pessoas Cabine (por dia)],
        "Pessoas Trançagem / Cabine", [Conf2 · Pessoas Trançagem / Cabine],
        "m por Pessoa Cabine", [Conf2 · m por Pessoa Cabine],
        "Eficiência de Balanceamento", [Conf2 · Eficiência de Balanceamento],
        "Lead Time do Processo (h)", [Conf2 · Lead Time do Processo (h)],
        "WIP Little (m)", [Conf2 · WIP Little (m)],
        "CV Vazão Trançagem", [Conf2 · CV Vazão Trançagem],
        "Rendimento de Fluxo", [Conf2 · Rendimento de Fluxo],
        "Dias Produtivos", [Conf2 · Dias Produtivos],
        "Restrição (menor m/dia)", [Conf2 · Restrição (menor m/dia)]
    ),
    dCalendario[Date] <= DATE ( 2026, 10, 6 )
)

// 3) Por etapa, só o 1º turno (filtro direto em fHoraHora[Turno], como a segmentação)
EVALUATE
CALCULATETABLE (
        VAR __Datas = CALCULATETABLE ( VALUES ( dCalendario[Date] ), REMOVEFILTERS ( fHoraHora[Turno] ), REMOVEFILTERS ( ficha_producao[Trançadeira] ) )
        VAR __UmDia = COUNTROWS ( __Datas ) = 1
        VAR __FT = ISFILTERED ( fHoraHora[Turno] )
        VAR __Turnos =
            FILTER (
                SELECTCOLUMNS (
                    CALCULATETABLE ( VALUES ( fHoraHora[Turno] ), REMOVEFILTERS ( dCalendario ) ),
                    "@T", VAR __tTx = fHoraHora[Turno] & "" VAR __tP1 = SEARCH ( "1", __tTx, 1, 999 ) VAR __tP2 = SEARCH ( "2", __tTx, 1, 999 ) VAR __tP3 = SEARCH ( "3", __tTx, 1, 999 ) VAR __tPm = MIN ( MIN ( __tP1, __tP2 ), __tP3 ) RETURN IF ( __tPm = 999, BLANK (), IF ( __tPm = __tP1, 1, IF ( __tPm = __tP2, 2, 3 ) ) )
                ),
                NOT ISBLANK ( [@T] )
            )
        VAR __FM = ISFILTERED ( ficha_producao[Trançadeira] )
        VAR __Maqs = DISTINCT ( SELECTCOLUMNS ( FILTERS ( ficha_producao[Trançadeira] ), "@M", VAR __mqSel = UPPER ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( ficha_producao[Trançadeira], ".", "" ), "-", "" ), " ", "" ), "_", "" ) ) RETURN IF ( __mqSel IN { "SPIRAL", "TE01", "TE0" }, "SPIRAL", __mqSel ) ) )
        VAR __MaqTxt = CONCATENATEX ( FILTER ( __Maqs, [@M] <> "" ), [@M], ", ", [@M], ASC )
        VAR __TemSp = "SPIRAL" IN __Maqs
        VAR __TemBr = NOT ISEMPTY ( FILTER ( __Maqs, [@M] <> "SPIRAL" ) )
        VAR __NomeTr = IF ( NOT __FM || ( __TemSp && __TemBr ), "Trançagem + Espiral", IF ( __TemSp, "Espiral", "Trançagem" ) )
        VAR __B =
        UNION (
            FILTER (
                SELECTCOLUMNS (
                    FILTER ( ALL ( ficha_producao ), NOT ISBLANK ( ficha_producao[data_hora_final_mandril] ) ),
                    "@E", 1,
                    "@Dia", VAR __fS1 = ficha_producao[data_hora_final_mandril] - 320 / 1440 RETURN DATE ( YEAR ( __fS1 ), MONTH ( __fS1 ), DAY ( __fS1 ) ),
