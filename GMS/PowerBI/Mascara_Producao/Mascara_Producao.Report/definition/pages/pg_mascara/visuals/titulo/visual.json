{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.14.0/schema.json",
  "name": "titulo",
  "position": {
    "x": 16,
    "y": 16,
    "z": 1000,
    "height": 56,
    "width": 1248,
    "tabOrder": 1000
  },
  "visual": {
    "visualType": "image",
    "objects": {
      "image": [
        {
          "properties": {
            "sourceType": {
              "expr": {
                "Literal": {
                  "Value": "'imageUrl'"
                }
              }
            },
            "sourceUrl": {
              "expr": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Medidas"
                    }
                  },
                  "Property": "SVG Título"
                }
              }
            }
          }
        }
      ],
      "imageScaling": [
        {
          "properties": {
            "imageScalingType": {
              "expr": {
                "Literal": {
                  "Value": "'Fit'"
                }
              }
            }
          }
        }
      ]
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "false"
                }
              }
            }
          }
        }
      ],
      "background": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "false"
                }
              }
            }
          }
        }
      ],
      "general": [
        {
          "properties": {
            "altText": {
              "expr": {
                "Literal": {
                  "Value": "'Faixa de título: Estamos no ritmo para fechar a meta do mês? Mostra a data da última MB51 e os dias úteis contabilizados.'"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}