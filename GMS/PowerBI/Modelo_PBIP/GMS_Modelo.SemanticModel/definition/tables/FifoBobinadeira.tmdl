table FifoBobinadeira
	lineageTag: 136872e7-a77d-4863-a429-b4bddf1a38bd

	/// Metragem bobinada (FifoBobinadeira). Join virtual de data via INT(DataHoraInicio).
	measure 'Metragem Bobinada' = VAR temCal = ISCROSSFILTERED(dCalendario[Date]) VAR datas = VALUES(dCalendario[Date]) RETURN IF(temCal, SUMX(FILTER(FifoBobinadeira, INT(FifoBobinadeira[DataHoraInicio]) IN datas), FifoBobinadeira[Metragem]), SUM(FifoBobinadeira[Metragem]))
		formatString: #,##0
		displayFolder: 12 Bobinadeira
		lineageTag: 3c88f1d0-dce8-4344-9f25-f3cf2e83cea9

	/// Quantidade refugada na bobinadeira. QuantidadeRefugo e coluna TEXTO no SharePoint: conversao via VALUE com IFERROR (linhas nao numericas contam 0). Corrigir o tipo da coluna na lista e o fix definitivo (auditar Patches antes). Join virtual de data via INT(DataHoraRefugo).
	measure 'Refugo Bobinadeira' = VAR temCal = ISCROSSFILTERED(dCalendario[Date]) VAR datas = VALUES(dCalendario[Date]) RETURN SUMX(FILTER(Refugo_Bobinadeira, NOT temCal || INT(Refugo_Bobinadeira[DataHoraRefugo]) IN datas), IFERROR(VALUE(Refugo_Bobinadeira[QuantidadeRefugo]), 0))
		formatString: #,##0
		displayFolder: 12 Bobinadeira
		lineageTag: 60f5e919-37f3-4703-930e-9b922daf5f8a

