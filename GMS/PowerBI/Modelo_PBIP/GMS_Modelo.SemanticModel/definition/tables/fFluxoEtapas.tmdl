	column Mangueira = LOOKUPVALUE(ficha_producao[Mangueira_Limpa], ficha_producao[ID], fFluxoEtapas[ID_Ficha])
		lineageTag: 05deaf96-eec8-47c7-9b2b-9657978ebb2d
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Bitola = LOOKUPVALUE(ficha_producao[Bitola_Corrigida], ficha_producao[ID], fFluxoEtapas[ID_Ficha])
		lineageTag: f0997741-3891-4039-a7ce-042cef6999a9
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	partition fFluxoEtapas = calculated
		mode: import
		source =
				VAR _E1 = SELECTCOLUMNS(FILTER(ficha_producao, NOT ISBLANK(ficha_producao[data_hora_inicio_mandril]) && NOT ISBLANK(ficha_producao[data_hora_final_mandril])), "ID_Ficha", ficha_producao[ID], "Ordem_Etapa", 1, "Etapa", "1 Mandril", "Ini_Fila", ficha_producao[data_hora_inicio_mandril], "Ini_Proc", ficha_producao[data_hora_inicio_mandril], "Fim", ficha_producao[data_hora_final_mandril], "Fila_Medida", FALSE())
				VAR _E2 = SELECTCOLUMNS(FILTER(ficha_producao, NOT ISBLANK(ficha_producao[InicioEmProcesso_Tubo]) && NOT ISBLANK(ficha_producao[data_hora_final_tubo])), "ID_Ficha", ficha_producao[ID], "Ordem_Etapa", 2, "Etapa", "2 Tubo", "Ini_Fila", COALESCE(ficha_producao[InicioAguardando_Tubo], ficha_producao[InicioEmProcesso_Tubo]), "Ini_Proc", ficha_producao[InicioEmProcesso_Tubo], "Fim", ficha_producao[data_hora_final_tubo], "Fila_Medida", NOT ISBLANK(ficha_producao[InicioAguardando_Tubo]))
				VAR _E3 = SELECTCOLUMNS(FILTER(ficha_producao, NOT ISBLANK(ficha_producao[InicioEmProcesso_Trançagem]) && NOT ISBLANK(ficha_producao[data_hora_final_trancadeira])), "ID_Ficha", ficha_producao[ID], "Ordem_Etapa", 3, "Etapa", "3 Trançagem", "Ini_Fila", COALESCE(ficha_producao[InicioAguardando_Trançadeira], ficha_producao[InicioEmProcesso_Trançagem]), "Ini_Proc", ficha_producao[InicioEmProcesso_Trançagem], "Fim", ficha_producao[data_hora_final_trancadeira], "Fila_Medida", NOT ISBLANK(ficha_producao[InicioAguardando_Trançadeira]))
				VAR _E4 = SELECTCOLUMNS(FILTER(ficha_producao, NOT ISBLANK(ficha_producao[InicioEmProcesso_Cobertura]) && NOT ISBLANK(ficha_producao[data_hora_final_cobertura])), "ID_Ficha", ficha_producao[ID], "Ordem_Etapa", 4, "Etapa", "4 Cobertura", "Ini_Fila", COALESCE(ficha_producao[InicioAguardandoCobertura], ficha_producao[InicioEmProcesso_Cobertura]), "Ini_Proc", ficha_producao[InicioEmProcesso_Cobertura], "Fim", ficha_producao[data_hora_final_cobertura], "Fila_Medida", NOT ISBLANK(ficha_producao[InicioAguardandoCobertura]))
				VAR _E5 = SELECTCOLUMNS(FILTER(ficha_producao, NOT ISBLANK(ficha_producao[InicioEmProcesso_Bandagem]) && NOT ISBLANK(ficha_producao[data_hora_final_bandagem])), "ID_Ficha", ficha_producao[ID], "Ordem_Etapa", 5, "Etapa", "5 Bandagem", "Ini_Fila", COALESCE(ficha_producao[InicioAguardando_bandagem], ficha_producao[InicioEmProcesso_Bandagem]), "Ini_Proc", ficha_producao[InicioEmProcesso_Bandagem], "Fim", ficha_producao[data_hora_final_bandagem], "Fila_Medida", NOT ISBLANK(ficha_producao[InicioAguardando_bandagem]))
				VAR _E6 = SELECTCOLUMNS(FILTER(ficha_producao, NOT ISBLANK(ficha_producao[InicioEmProcesso_Vulcanização]) && NOT ISBLANK(ficha_producao[data_hora_final_vulcanizacao])), "ID_Ficha", ficha_producao[ID], "Ordem_Etapa", 6, "Etapa", "6 Vulcanização", "Ini_Fila", COALESCE(ficha_producao[InicioAguardando_Vulcanização], ficha_producao[InicioEmProcesso_Vulcanização]), "Ini_Proc", ficha_producao[InicioEmProcesso_Vulcanização], "Fim", ficha_producao[data_hora_final_vulcanizacao], "Fila_Medida", NOT ISBLANK(ficha_producao[InicioAguardando_Vulcanização]))
				VAR _E7 = SELECTCOLUMNS(FILTER(ficha_producao, NOT ISBLANK(ficha_producao[InicioEmProcesso_Debandagem]) && NOT ISBLANK(ficha_producao[data_hora_final_debandagem])), "ID_Ficha", ficha_producao[ID], "Ordem_Etapa", 7, "Etapa", "7 Debandagem", "Ini_Fila", COALESCE(ficha_producao[InicioAguardando_Debandagem], ficha_producao[InicioEmProcesso_Debandagem]), "Ini_Proc", ficha_producao[InicioEmProcesso_Debandagem], "Fim", ficha_producao[data_hora_final_debandagem], "Fila_Medida", NOT ISBLANK(ficha_producao[InicioAguardando_Debandagem]))
				VAR _E8 = SELECTCOLUMNS(FILTER(ficha_producao, NOT ISBLANK(ficha_producao[InicioEmProcesso_Extr./Teste]) && NOT ISBLANK(ficha_producao[data_hora_final_extracao])), "ID_Ficha", ficha_producao[ID], "Ordem_Etapa", 8, "Etapa", "8 Extr./Teste", "Ini_Fila", COALESCE(ficha_producao[InicioAguardando_Extr./Teste], ficha_producao[InicioEmProcesso_Extr./Teste]), "Ini_Proc", ficha_producao[InicioEmProcesso_Extr./Teste], "Fim", ficha_producao[data_hora_final_extracao], "Fila_Medida", NOT ISBLANK(ficha_producao[InicioAguardando_Extr./Teste]))
				VAR _U = UNION(_E1, _E2, _E3, _E4, _E5, _E6, _E7, _E8)
				RETURN ADDCOLUMNS(_U, "Data_Fim", DATE(YEAR([Fim]), MONTH([Fim]), DAY([Fim])), "Fila_h", ([Ini_Proc] - [Ini_Fila]) * 24.0, "Proc_h", ([Fim] - [Ini_Proc]) * 24.0, "Lead_h", ([Fim] - [Ini_Fila]) * 24.0, "Valida", ([Ini_Proc] - [Ini_Fila]) >= 0 && ([Fim] - [Ini_Proc]) >= 0)

