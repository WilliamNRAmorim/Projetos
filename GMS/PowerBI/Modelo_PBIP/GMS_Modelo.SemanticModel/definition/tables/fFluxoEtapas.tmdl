/// Fato de fila/processamento por etapa. Base da analise de lead time e Teoria das Restricoes.
table fFluxoEtapas
	lineageTag: 67bbe416-173a-4a8c-b0c5-ae1811d77f1b

	/// Tempo mediano de FILA (espera) na etapa, em horas. Mediana e nao media: a distribuicao tem cauda longa e a media e distorcida por OPs travadas.
	measure 'Fila Mediana (h)' = MEDIANX(FILTER(fFluxoEtapas, fFluxoEtapas[Valida]), fFluxoEtapas[Fila_h])
		formatString: 0.0
		displayFolder: 14 Fluxo e Lead Time
		lineageTag: d764f525-32cc-4a37-88c5-5470323f239b

	/// Tempo mediano de PROCESSAMENTO (trabalho efetivo) na etapa, em horas.
	measure 'Proc Mediana (h)' = MEDIANX(FILTER(fFluxoEtapas, fFluxoEtapas[Valida]), fFluxoEtapas[Proc_h])
		formatString: 0.0
		displayFolder: 14 Fluxo e Lead Time
		lineageTag: 19e31ac3-b99f-4cf6-ab14-1235b8757cb1

	/// Lead time mediano da etapa (fila + processamento), em horas.
	measure 'Lead Mediana (h)' = MEDIANX(FILTER(fFluxoEtapas, fFluxoEtapas[Valida]), fFluxoEtapas[Lead_h])
		formatString: 0.0
		displayFolder: 14 Fluxo e Lead Time
		lineageTag: 7bfa693d-38b4-418a-afae-e8e18fd4777e

	/// Fila no percentil 90 (h). Mostra o pior caso realista, nao o outlier absoluto. Use junto da mediana para dimensionar a cauda.
	measure 'Fila P90 (h)' = PERCENTILEX.INC(FILTER(fFluxoEtapas, fFluxoEtapas[Valida]), fFluxoEtapas[Fila_h], 0.9)
		formatString: 0.0
		displayFolder: 14 Fluxo e Lead Time
		lineageTag: db28df84-8537-4433-9b7d-54a4c0fea63b

	/// Eficiencia de fluxo (Lean) = tempo de processamento / lead time total. Percentual do tempo em que a peca esta efetivamente sendo trabalhada. Referencia de industria discreta costuma ficar abaixo de 10%.
	measure 'Eficiencia de Fluxo' = DIVIDE(SUMX(FILTER(fFluxoEtapas, fFluxoEtapas[Valida]), fFluxoEtapas[Proc_h]), SUMX(FILTER(fFluxoEtapas, fFluxoEtapas[Valida]), fFluxoEtapas[Lead_h]))
		formatString: 0.0%
		displayFolder: 14 Fluxo e Lead Time
		lineageTag: 9fc3f991-6479-43a8-8ac0-75c220385c6f

	/// Quantas vezes a espera supera o trabalho efetivo na etapa (fila mediana / processamento mediano). Acima de 1 significa que a peca espera mais do que e trabalhada.
	measure 'Razao Fila-Processo' = DIVIDE([Fila Mediana (h)], [Proc Mediana (h)])
		formatString: 0.0"x"
		displayFolder: 14 Fluxo e Lead Time
		lineageTag: 4dd86522-b6f6-4f2f-b1b3-fcf6dd380eed

	/// Lead time medio total de uma ficha somando todas as etapas medidas, em horas. Base da analise de Teoria das Restricoes.
	measure 'Lead Total por Ficha (h)' = AVERAGEX(VALUES(fFluxoEtapas[ID_Ficha]), CALCULATE(SUMX(FILTER(fFluxoEtapas, fFluxoEtapas[Valida]), fFluxoEtapas[Lead_h])))
		formatString: 0.0
		displayFolder: 14 Fluxo e Lead Time
		lineageTag: 39ce478c-8f72-451e-befd-62e6cf694458

	/// Nome da etapa com a maior fila mediana no contexto filtrado. E o gargalo do fluxo segundo a Teoria das Restricoes. Use em cartao.
	measure 'Etapa Gargalo' = VAR _T = ADDCOLUMNS(VALUES(fFluxoEtapas[Etapa]), "@Fila", [Fila Mediana (h)]) VAR _Max = MAXX(_T, [@Fila]) RETURN IF(ISBLANK(_Max), BLANK(), CONCATENATEX(FILTER(_T, [@Fila] = _Max), fFluxoEtapas[Etapa], ", "))
		displayFolder: 14 Fluxo e Lead Time
		lineageTag: 77f51df1-e37d-46b1-8786-1867ef83b171

	/// Registros de etapa validos no contexto (carimbos coerentes).
	measure 'Etapas Medidas' = COUNTROWS(FILTER(fFluxoEtapas, fFluxoEtapas[Valida]))
		formatString: #,0
		displayFolder: 14 Fluxo e Lead Time
		lineageTag: a983c27c-0015-4c7f-8e40-7e0c1746c4d1

	/// % de registros com carimbos invertidos (fim antes do inicio). Indicador de qualidade de dado do apontamento, nao de produtividade.
	measure '% Carimbos Invalidos' = DIVIDE(COUNTROWS(FILTER(fFluxoEtapas, NOT fFluxoEtapas[Valida])), COUNTROWS(fFluxoEtapas))
		formatString: 0.0%
		displayFolder: 14 Fluxo e Lead Time\Qualidade de Dado
		lineageTag: f3a45e24-b059-4e36-b0f2-dd5e88154ebe

	/// Tempo MEDIO de fila na etapa (h). Criada especificamente para o grafico de barras empilhadas: medias sao aditivas (Fila Media + Proc Media = Lead Media), medianas nao. Para leitura de tipico use a mediana; para composicao empilhada use esta.
	measure 'Fila Media (h)' = AVERAGEX(FILTER(fFluxoEtapas, fFluxoEtapas[Valida]), fFluxoEtapas[Fila_h])
		formatString: 0.0
		displayFolder: 14 Fluxo e Lead Time\Aditivas (para empilhado)
		lineageTag: afc33ac3-ae21-45e1-bd4a-44f286cf848e

	/// Tempo MEDIO de processamento na etapa (h). Par aditivo de Fila Media (h) para o grafico empilhado.
	measure 'Proc Media (h)' = AVERAGEX(FILTER(fFluxoEtapas, fFluxoEtapas[Valida]), fFluxoEtapas[Proc_h])
		formatString: 0.0
		displayFolder: 14 Fluxo e Lead Time\Aditivas (para empilhado)
		lineageTag: 3bc32134-d83e-46a5-94c7-d1aeda86a11e

	column ID_Ficha
		lineageTag: 1803e2e3-2bcc-4e2f-8d23-a3170abad112
