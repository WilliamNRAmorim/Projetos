	partition ficha_producao = m
		mode: import
		source =
				let
				    Fonte = SharePoint.Tables("https://danfoss.sharepoint.com/sites/OperationsGuaratingueta", [Implementation="2.0", ViewMode="All"]),
				    Origem = Fonte{[Id="e963db72-b7d4-4cbb-8613-cf6f7bc6b8f3"]}[Items],
				    Renomeado = Table.RenameColumns(Origem,{{"Processo", "Processo.1"}}),
				    Limpo = Table.RemoveColumns(Renomeado, {"Color Tag","Compliance Asset Id","Content Type","Item Child Count","Folder Child Count","Label setting","Retention label","App Created By","App Modified By","Title"}, MissingField.Ignore)
				in
				    Limpo

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

