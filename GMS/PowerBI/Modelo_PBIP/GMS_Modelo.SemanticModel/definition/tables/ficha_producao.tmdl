table ficha_producao
	lineageTag: b2670663-f96b-4c3f-9c8c-86a404eddb7d

	/// Metragem total produzida (extraída) em metros. Métrica principal de produção.
	measure 'Metragem Produzida' = SUM('ficha_producao'[Metragem_Extracao])
		formatString: #,0 "m"
		displayFolder: 01 Produção
		lineageTag: 3377c40f-b985-4b8d-81e7-98c25f451fd8

	/// Quantidade de mangueiras (fichas) que passaram pela extração, ou seja, com metragem > 0.
	measure 'Qtd Mangueiras Produzidas' = CALCULATE(COUNTROWS('ficha_producao'), 'ficha_producao'[Metragem_Extracao] > 0)
		formatString: #,0
		displayFolder: 01 Produção
		lineageTag: 59d26a51-2f51-46b0-85cc-222443644a07

	/// Metragem média por mangueira produzida.
	measure 'Metragem Media por Mangueira' = DIVIDE([Metragem Produzida], [Qtd Mangueiras Produzidas])
		formatString: #,0.0 "m"
		displayFolder: 01 Produção
		lineageTag: 34556789-1140-4ad2-a01a-db9dd7666587

	/// Total de fichas/ordens registradas no período (qualquer status).
	measure 'Total Fichas' = COUNTROWS('ficha_producao')
		formatString: #,0
		displayFolder: 01 Produção
		lineageTag: 28511f96-712d-421f-a310-e7d19c9ee662

	/// Fichas finalizadas (status = Finalizado).
	measure 'Fichas Finalizadas' = CALCULATE(COUNTROWS('ficha_producao'), 'ficha_producao'[status_processo] = "Finalizado")
		formatString: #,0
		displayFolder: 01 Produção
		lineageTag: eb35639f-fe10-4c85-bdfc-1de42a55603b

	/// Fichas em processo (status = Em processo).
	measure 'Fichas Em Processo' = CALCULATE(COUNTROWS('ficha_producao'), 'ficha_producao'[status_processo] = "Em processo")
		formatString: #,0
		displayFolder: 01 Produção
		lineageTag: 1cd7cd68-3b40-479f-8633-caefda6182c8

	/// Fichas aguardando próxima etapa (status = Aguardando).
	measure 'Fichas Aguardando' = CALCULATE(COUNTROWS('ficha_producao'), 'ficha_producao'[status_processo] = "Aguardando")
		formatString: #,0
		displayFolder: 01 Produção
		lineageTag: 09717dd0-1773-4317-8ec7-01cb31360ed4

	/// Soma de defeitos registrados na trançagem.
	measure 'Defeitos Trancagem' = SUM('ficha_producao'[defeito_trancagem_trat])
		formatString: #,0
		displayFolder: 02 Qualidade
		lineageTag: 58178825-f534-4d18-a31f-557533c2a251

	/// Soma de defeitos registrados na cobertura.
	measure 'Defeitos Cobertura' = SUM('ficha_producao'[defeito_cobertura_trat])
		formatString: #,0
		displayFolder: 02 Qualidade
		lineageTag: a818da81-f736-41e6-9483-6d89b5a82719

	/// Soma de defeitos registrados no tubo.
	measure 'Defeitos Tubo' = SUM('ficha_producao'[defeito_tubo_trat])
		formatString: #,0
		displayFolder: 02 Qualidade
		lineageTag: 2c8a1e2e-4dca-4eee-8be4-8cd8bcd26e79

	/// Total de defeitos somando todas as etapas.
	measure 'Total Defeitos' = [Defeitos Trancagem] + [Defeitos Cobertura] + [Defeitos Tubo]
		formatString: #,0
		displayFolder: 02 Qualidade
		lineageTag: dcc9e562-5c1f-4a0a-bfc8-cc9acd663c4a

	/// Total de registros de inspeção de qualidade.
	measure 'Total Inspecoes' = COUNTROWS('RegistrosInspeção')
		formatString: #,0
		displayFolder: 02 Qualidade
		lineageTag: 432f50e3-ce22-47ee-ac9f-5f4bed977837

	/// Fichas com bitola que precisou ser corrigida (divergente, vazia ou irrecuperável).
	measure 'Fichas Bitola Corrigida' = CALCULATE(COUNTROWS('ficha_producao'), 'ficha_producao'[Flag_Qualidade_Bitola] <> "OK")
		formatString: #,0
		displayFolder: 02 Qualidade\Tratamento
		lineageTag: 2668fe13-9060-4d7f-a805-b9ad942af961

	/// Fichas com inconsistência temporal (data final antes da inicial em alguma etapa).
	measure 'Fichas Data Invertida' = CALCULATE(COUNTROWS('ficha_producao'), 'ficha_producao'[Flag_Data_Invertida] = TRUE())
		formatString: #,0
		displayFolder: 02 Qualidade\Tratamento
		lineageTag: d989b8af-035f-4715-9b3d-69084bb8951a

	/// % de fichas com qualidade de dados OK na bitola.
	measure '% Qualidade Dados Bitola' = DIVIDE(CALCULATE(COUNTROWS('ficha_producao'), 'ficha_producao'[Flag_Qualidade_Bitola] = "OK"), COUNTROWS('ficha_producao'))
		formatString: 0.0%
		displayFolder: 02 Qualidade\Tratamento
		lineageTag: 26b7f246-30d1-411b-bacb-6e28842ed182

	/// Metragem produzida no Turno 1 (extração).
	measure 'Metragem Turno 1' = CALCULATE([Metragem Produzida], 'ficha_producao'[Turno_Producao] = "Turno 1")
		formatString: #,0 "m"
		displayFolder: 03 Por Turno
		lineageTag: 7aeff7bb-63b9-4ac5-ae8b-f70b50b7acfa

	/// Metragem produzida no Turno 2 (extração).
	measure 'Metragem Turno 2' = CALCULATE([Metragem Produzida], 'ficha_producao'[Turno_Producao] = "Turno 2")
		formatString: #,0 "m"
		displayFolder: 03 Por Turno
		lineageTag: b8db5dec-8c3a-4466-9604-0ebb7303e552

	/// Metragem produzida no Turno 3 (extração).
	measure 'Metragem Turno 3' = CALCULATE([Metragem Produzida], 'ficha_producao'[Turno_Producao] = "Turno 3")
		formatString: #,0 "m"
		displayFolder: 03 Por Turno
		lineageTag: cd3dcd7b-edbc-4b8d-9b57-076d4152ed5b

	/// Tempo médio de ciclo em horas (início mandril -> fim extração), ignorando fichas incompletas.
	measure 'Tempo Ciclo Medio (h)' = AVERAGEX(FILTER('ficha_producao', NOT(ISBLANK('ficha_producao'[TempoCiclo_Horas]))), 'ficha_producao'[TempoCiclo_Horas])
		formatString: #,0.0 "h"
		displayFolder: 04 Tempo de Ciclo
		lineageTag: c9e41eb7-e658-4b08-890a-c69f039b0f77

	/// Tempo de ciclo em dias (média).
	measure 'Tempo Ciclo Medio (dias)' = DIVIDE([Tempo Ciclo Medio (h)], 24)
		formatString: #,0.0 "dias"
		displayFolder: 04 Tempo de Ciclo
		lineageTag: 1e165bfd-f130-42c0-bdb1-74ec812e0237

	/// Maior tempo de ciclo registrado (horas).
	measure 'Tempo Ciclo Maximo (h)' = MAXX('ficha_producao', 'ficha_producao'[TempoCiclo_Horas])
		formatString: #,0.0 "h"
		displayFolder: 04 Tempo de Ciclo
		lineageTag: bc8d593f-0ba1-46c5-b2ac-c67916a58e13

	/// Taxa de defeitos por mangueira produzida (defeitos totais tratados / qtd produzida).
	measure 'Defeitos por Mangueira' = DIVIDE([Total Defeitos], [Qtd Mangueiras Produzidas])
		formatString: 0.00
		displayFolder: 02 Qualidade
		lineageTag: bc76afca-25f7-42d2-a2d7-9a84944f4eb7

	/// Meta (Plan) de metragem por C.Standard, do Hose Plan. Sensivel ao mes (AnoMes_Producao). Carregados: Maio/2026 (202605) e Junho/2026 (202606). Default = Junho. Para novos meses, adicionar as linhas no SWITCH.
	measure 'Meta Plan' = VAR mes = SELECTEDVALUE('ficha_producao'[AnoMes_Producao], 202606) RETURN SUMX(VALUES('Part Number x Construction'[C_Standard_Plan]), VAR cs = 'Part Number x Construction'[C_Standard_Plan] RETURN SWITCH(TRUE(), mes = 202605 && cs = "DD24-08/10/12", 67205, mes = 202605 && cs = "DD20-04/06", 28909, mes = 202605 && cs = "SD20-04/06", 24280, mes = 202605 && cs = "TEXTILE-07/08/10/12/16", 18460, mes = 202605 && cs = "SPIRAL", 13249, mes = 202605 && cs = "SD24-08/10/12", 11680, mes = 202605 && cs = "SD/DD36-16", 10000, mes = 202605 && cs = "TEXTILE-03/04/05/06", 3400, mes = 202606 && cs = "DD24-08/10/12", 54540, mes = 202606 && cs = "DD20-04/06", 24560, mes = 202606 && cs = "SD20-04/06", 24560, mes = 202606 && cs = "SD24-08/10/12", 15100, mes = 202606 && cs = "SPIRAL", 13420, mes = 202606 && cs = "SD/DD36-16", 10250, mes = 202606 && cs = "TEXTILE-03/04/05/06", 9560, mes = 202606 && cs = "TEXTILE-07/08/10/12/16", 8400, BLANK()))
		formatString: #,##0
		displayFolder: 05 Hose Plan
		lineageTag: a3c95d48-5990-420c-bc4a-352ab5315396

	/// Metragem realizada (MTD) considerando o mes de producao selecionado. Use com slicer de MesProducao/AnoMes_Producao.
	measure 'Realizado MTD' = [Metragem Produzida]
		formatString: #,##0
		displayFolder: 05 Hose Plan
		lineageTag: d3e45bb8-207f-4393-a845-b4b665357da1

	/// % de atingimento da meta: Realizado MTD / Meta Plan.
	measure '% Atingimento Meta' = DIVIDE([Realizado MTD], [Meta Plan])
		formatString: 0.0%
		displayFolder: 05 Hose Plan
		lineageTag: ad31bd16-c786-4f1b-a8a5-9abe88e9cb5d

	/// GAP de metragem: Realizado MTD - Meta Plan. Negativo = abaixo da meta.
	measure 'GAP Meta' = [Realizado MTD] - [Meta Plan]
		formatString: #,##0
		displayFolder: 05 Hose Plan
		lineageTag: 01f40490-343b-4d61-a57d-03c1d5f1cb2f

	/// Metragem que falta para bater a meta (0 se ja atingiu).
	measure 'Falta para Meta' = VAR g = [Meta Plan] - [Realizado MTD] RETURN IF(g > 0, g, 0)
		formatString: #,##0
		displayFolder: 05 Hose Plan
		lineageTag: e56553db-d834-4e41-bc82-aa5c9a8f473f

	/// Dias uteis totais do mes de referencia (K34 do Hose Plan). Maio=23, Junho=21. Editar por mes.
	measure 'Dias Uteis Mes' = VAR mes = SELECTEDVALUE('ficha_producao'[AnoMes_Producao], 202606) RETURN SWITCH(mes, 202605, 23, 202606, 21, BLANK())
		formatString: 0
		displayFolder: 05 Hose Plan\Ritmo
		lineageTag: 0aa1b8a4-964e-44e3-8a12-8c44c2566d77

	/// Dias uteis (seg-sex) decorridos no mes de producao ate hoje. Mes ja fechado retorna o total (100% do ritmo). Mes futuro retorna 0. Automatico - nao precisa editar por mes.
	measure 'Dias Uteis Decorridos' = VAR mes = SELECTEDVALUE('ficha_producao'[AnoMes_Producao], 202605) VAR ano = INT(mes / 100) VAR m = MOD(mes, 100) VAR inicioMes = DATE(ano, m, 1) VAR fimMes = EOMONTH(inicioMes, 0) VAR hoje = TODAY() RETURN SWITCH(TRUE(), hoje > fimMes, [Dias Uteis Mes], hoje < inicioMes, 0, VAR ateData = hoje VAR dias = GENERATESERIES(inicioMes, ateData, 1) RETURN COUNTROWS(FILTER(dias, WEEKDAY([Value], 2) <= 5)))
		formatString: 0
		displayFolder: 05 Hose Plan\Ritmo
		lineageTag: 2bfb92e0-cf43-4215-8cd7-1508ad8c751a

	/// % do ritmo esperado = dias decorridos / dias totais (campo K36 do Hose Plan). Fracao do plano que deveria estar feita ate agora.
	measure '% Ritmo Esperado' = DIVIDE([Dias Uteis Decorridos], [Dias Uteis Mes])
		formatString: 0.0%
		displayFolder: 05 Hose Plan\Ritmo
		lineageTag: 054907e1-1968-4409-8cac-46517f4c8c5c

	/// Atraso em metros vs o ritmo esperado: (% ritmo esperado - % atingimento) x Meta. Positivo = atrasado em relacao ao planejado ate a data. Replica a coluna Atraso do Hose Plan (G = (K36-F)*D).
	measure Atraso = VAR plan = [Meta Plan] RETURN IF(plan > 0, ([% Ritmo Esperado] - [% Atingimento Meta]) * plan, 0)
		formatString: #,##0
		displayFolder: 05 Hose Plan
		lineageTag: c83330dc-36b8-4841-ab19-8fd33cac294e

	/// Meta diaria planejada (m/dia util) = Meta Plan / dias uteis do mes. No Excel estava cravada em 7700 (~177183/23).
	measure 'Meta Diaria Planejada' = DIVIDE([Meta Plan], [Dias Uteis Mes])
		formatString: #,##0
		displayFolder: 05 Hose Plan\Ritmo
		lineageTag: e2a4b88f-ca06-4d7f-a920-b82a69ffe331

	/// Dias uteis restantes no mes (dias totais - decorridos).
	measure 'Dias Restantes' = [Dias Uteis Mes] - [Dias Uteis Decorridos]
		formatString: 0
		displayFolder: 05 Hose Plan\Ritmo
		lineageTag: 2813dbee-b82c-4825-b714-9be3955ffc0e

	/// Total de atraso em metros (mesmo que Atraso no nivel total). Replica K40/G39 do Excel, mas com o realizado completo do GMS.
	measure 'Total Atraso' = [Atraso]
		formatString: #,##0
		displayFolder: 05 Hose Plan\Ritmo
		lineageTag: ba5d24e0-56b4-477f-b52b-a9e624b26f67

	/// Meta diaria ajustada para recuperar o atraso nos dias restantes = Meta diaria planejada + Atraso/dias restantes. Em branco quando o mes acabou (sem dias restantes) - trata o #DIV/0! do Excel.
	measure 'Meta Diaria Ajustada' = VAR dr = [Dias Restantes] RETURN IF(dr <= 0, BLANK(), [Meta Diaria Planejada] + DIVIDE([Total Atraso], dr))
		formatString: #,##0
		displayFolder: 05 Hose Plan\Ritmo
		lineageTag: 9134e885-95e5-4087-a1b1-66c0636af1e2

	/// Indicador binario do ritmo, igual ao Excel IF(Total Atraso<=0; feliz; triste). Feliz se atraso <= 0 (no ritmo ou adiantado), triste se > 0 (atrasado). Em branco se nao ha meta.
	measure 'Status Ritmo' = VAR m = [Meta Plan] VAR a = [Atraso] RETURN IF(ISBLANK(m) || m = 0, BLANK(), IF(a <= 0, "😀", "😟"))
		displayFolder: 05 Hose Plan\Ritmo
		lineageTag: f90f562f-f921-4233-bff3-2694fc6025b9

	/// OPs ativas no pipeline agora (nao finalizadas/descartadas, com atividade recente).
	measure 'OPs Ativas' = CALCULATE(COUNTROWS('ficha_producao'), 'ficha_producao'[Esta_Ativa] = TRUE())
		formatString: #,0
		displayFolder: 06 Supervisao
		lineageTag: 012813f2-fde3-48c2-a334-6f13e2b56400

	/// Metragem em processo (das OPs ativas).
	measure 'Metragem Em Processo' = CALCULATE(SUM('ficha_producao'[Metragem_Extracao]), 'ficha_producao'[Esta_Ativa] = TRUE())
		formatString: #,0 "m"
		displayFolder: 06 Supervisao
		lineageTag: af1aaeaa-2112-40ce-9654-5d5ad7730f8d

	/// OPs ativas paradas ha 3+ dias (sem modificacao), que requerem atencao.
	measure 'OPs Paradas +3 Dias' = VAR maxMod = MAXX(ALL('ficha_producao'), 'ficha_producao'[Modified]) RETURN CALCULATE(COUNTROWS('ficha_producao'), 'ficha_producao'[Esta_Ativa] = TRUE(), FILTER('ficha_producao', 'ficha_producao'[Modified] < maxMod - 3))
		formatString: #,0
		displayFolder: 06 Supervisao
		lineageTag: 571b4b77-bfae-4b29-b54a-d6bb40cba959

	/// OPs finalizadas hoje (data de finalizacao = data mais recente do sistema).
	measure 'OPs Finalizadas Hoje' = VAR hoje = MAXX(ALL('ficha_producao'), 'ficha_producao'[DataProducao]) RETURN CALCULATE(COUNTROWS('ficha_producao'), 'ficha_producao'[status_processo] = "Finalizado", FILTER('ficha_producao', 'ficha_producao'[DataProducao] = hoje))
		formatString: #,0
		displayFolder: 06 Supervisao
		lineageTag: 8e86d9a3-683c-404d-80de-d2c1857a3067

	/// Metragem produzida hoje (ultimo dia com producao no sistema).
	measure 'Metragem Hoje' = VAR hoje = MAXX(ALL('ficha_producao'), 'ficha_producao'[DataProducao]) RETURN CALCULATE(SUM('ficha_producao'[Metragem_Extracao]), FILTER('ficha_producao', 'ficha_producao'[DataProducao] = hoje))
		formatString: #,0 "m"
		displayFolder: 06 Supervisao
		lineageTag: 54895edf-4dd7-4c51-a874-e8ebc157e4d1

	/// Total de registros de refugo (cada linha da TiposErros = um refugo com codigo de erro).
	measure 'Total Refugos' = COUNTROWS('TiposErros')
		formatString: #,0
		displayFolder: 02 Qualidade
		lineageTag: 394a4b18-23a9-4385-8f10-20898e3bd691

	/// Refugos registrados no dia mais recente do sistema.
	measure 'Refugos Hoje' = VAR h = MAXX(ALL('TiposErros'), 'TiposErros'[DataHoraRefugo]) RETURN CALCULATE(COUNTROWS('TiposErros'), FILTER('TiposErros', YEAR('TiposErros'[DataHoraRefugo]) = YEAR(h) && MONTH('TiposErros'[DataHoraRefugo]) = MONTH(h) && DAY('TiposErros'[DataHoraRefugo]) = DAY(h)))
		formatString: #,0
		displayFolder: 02 Qualidade
		lineageTag: 58df0309-f247-4752-89f9-437f214e3bc7

	/// Taxa de refugo: refugos por mangueira produzida (proxy de qualidade).
	measure 'Refugos por Mangueira' = DIVIDE([Total Refugos], [Qtd Mangueiras Produzidas])
		formatString: 0.00
		displayFolder: 02 Qualidade
		lineageTag: 8d18e6b5-6946-4fd7-90b5-a0b3ad33d0e9

	/// Total de inspecoes de qualidade registradas.
	measure 'Total Inspecoes Qualidade' = COUNTROWS('RegistrosInspeção')
		formatString: #,0
		displayFolder: 02 Qualidade
		lineageTag: 437e7fdd-2562-44e3-86a6-f979cf24bbac

	/// Atingimento relativo ao ritmo esperado = % Atingimento / % Ritmo Esperado. 100% = exatamente no ritmo; >100% adiantado; <100% atrasado. Use ESTA medida na formatacao condicional do semaforo da matriz (em vez do % cru), para a cor fazer sentido em qualquer dia do mes.
	measure '% vs Ritmo' = DIVIDE([% Atingimento Meta], [% Ritmo Esperado])
		formatString: 0.0%
		displayFolder: 05 Hose Plan
		lineageTag: 7f13c8e1-f38e-43a9-b720-e369b0e7fbea

	/// Status do ritmo em texto claro para o cartão (substitui o emoji). 'No ritmo' quando Total Atraso <= 0, senão 'Atrasado X m'. Reduz esforço cognitivo: leitura direta sem interpretar carinha.
	measure 'Status Ritmo Texto' = VAR a = [Total Atraso] RETURN IF(NOT ISBLANK(a), IF(a <= 0, "▲ No ritmo", "▼ Atrasado " & FORMAT(a, "#,0") & " m"))
		displayFolder: 05 Hose Plan\Ritmo
		lineageTag: 28c7bc78-f45f-4d84-bd78-679e0ca940cd

	/// Quantidade produzida no Mandril, agrupada por Bitola e Turno. Base do Kanban Extrusora 1 - Mandril Soldado. Filtrar Bitola em branco no visual (não na medida: booleano em CALCULATE sobre a mesma coluna do agrupamento sobrescreve o contexto, vide P-series).
	measure 'Qtd Mandril por Bitola' = SUM(ficha_producao[quantidade_mandril])
		formatString: #,##0
		displayFolder: 13 Kanban Processos\Extrusora Mandril
		lineageTag: 73f10921-b11c-4b2a-a2bc-4e5f3205036c

	/// Rótulo pronto 'Bitola X' para linha do Kanban Extrusora, evitando expor o número cru sem contexto.
	measure 'Rotulo Bitola' = "Bitola " & SELECTEDVALUE(ficha_producao[Bitola])
		displayFolder: 13 Kanban Processos\Extrusora Mandril
		lineageTag: 32adca1b-b203-434d-91f0-53ffd6f9d1c0

	/// Quantidade produzida na etapa Tubo, por Mangueira/PN e Turno. Representa a fila (WIP) parada no Tubo aguardando avançar para Cobertura/Extração. Base do Kanban Extração - bloco Tubo.
	measure 'Qtd Fila Tubo' = CALCULATE(SUM(ficha_producao[quantidade_tubo]), NOT ISBLANK(ficha_producao[quantidade_tubo]))
		formatString: #,##0
		displayFolder: 13 Kanban Processos\Extração (filas)
		lineageTag: f223ed9a-2b1d-4325-94a6-877b0f1bf17c

	/// Quantidade produzida na etapa Cobertura, por Mangueira/PN e Turno. Representa a fila (WIP) parada na Cobertura aguardando avançar para Extração. Base do Kanban Extração - bloco Cobertura.
	measure 'Qtd Fila Cobertura' = CALCULATE(SUM(ficha_producao[quantidade_cobertura]), NOT ISBLANK(ficha_producao[quantidade_cobertura]))
		formatString: #,##0
		displayFolder: 13 Kanban Processos\Extração (filas)
		lineageTag: 1b2d6736-4118-4b9a-838e-3d80980303eb

	/// Duração total do turno na etapa Tubo (soma do intervalo inicio->fim de cada apontamento), para a linha de rodapé do Kanban Extração (formato hh:mm:ss). Em minutos brutos; formatar como horário no visual se precisar de hh:mm:ss.
	measure 'Duracao Turno Tubo (min)' = SUMX(FILTER(ficha_producao, NOT ISBLANK(ficha_producao[data_hora_inicio_tubo]) && NOT ISBLANK(ficha_producao[data_hora_final_tubo])), DATEDIFF(ficha_producao[data_hora_inicio_tubo], ficha_producao[data_hora_final_tubo], MINUTE))
		formatString: #,##0
		displayFolder: 13 Kanban Processos\Extração (filas)
		lineageTag: 53d2af80-908c-430c-b635-7fb094b5c832

	/// Tubo produzido na própria trançadeira (MQ). Turno_Tubo tem tipo misto (1/2/3 e 'Turno 1'/'Turno 3'), normalizado via FORMAT+SWITCH dentro do filtro, sem depender de coluna calculada (limitação conhecida do table_operations).
	measure 'MQ Producao Propria' = CALCULATE(SUM(ficha_producao[quantidade_tubo]), TREATAS(VALUES('Hora-Hora'[Célula]), ficha_producao[Trançadeira]), FILTER(ALL(ficha_producao[Turno_Tubo]), VAR t = TRIM(FORMAT(ficha_producao[Turno_Tubo], "")) VAR padrao = SWITCH(TRUE(), t IN {"1", "Turno 1"}, "1º Turno", t IN {"2", "Turno 2"}, "2º Turno", t IN {"3", "Turno 3"}, "3º Turno", BLANK()) RETURN padrao IN VALUES('Hora-Hora'[Turno])))
		formatString: #,##0
		displayFolder: 13 Kanban Processos\Tubo das Trançadeiras
		lineageTag: 4ae3a6bb-1648-4a74-b57d-78fc7c456631

	/// Metragem vinda da Bobinadeira (KB) para a mesma trançadeira/turno/dia. Turno normalizado via SWITCH; data via join virtual INT(DataHoraInicio), pois a tabela não tem relacionamento físico com dCalendario (datetime com hora).
	measure 'KB Bobinadeira' = VAR temCal = ISCROSSFILTERED(dCalendario[Date]) VAR datas = VALUES(dCalendario[Date]) RETURN CALCULATE(SUM(FifoBobinadeira[Metragem]), TREATAS(VALUES('Hora-Hora'[Célula]), FifoBobinadeira[Trancadeira]), FILTER(ALL(FifoBobinadeira[Turno]), SWITCH(FifoBobinadeira[Turno], 1, "1º Turno", 2, "2º Turno", 3, "3º Turno", BLANK()) IN VALUES('Hora-Hora'[Turno])), FILTER(ALL(FifoBobinadeira[DataHoraInicio]), NOT temCal || INT(FifoBobinadeira[DataHoraInicio]) IN datas))
		formatString: #,##0
		displayFolder: 13 Kanban Processos\Tubo das Trançadeiras
		lineageTag: 73bcb238-4d28-4f10-a29e-9ec103a580de

	/// Total do Tubo por Trançadeira/Turno = MQ (própria máquina) + KB (Bobinadeira). Coluna TT do painel Tubo das Trançadeiras.
	measure 'TT Total Tubo' = [MQ Producao Propria] + [KB Bobinadeira]
		formatString: #,##0
		displayFolder: 13 Kanban Processos\Tubo das Trançadeiras
		lineageTag: 52a4c04c-9e97-4772-bf26-192991ca4f61

	/// Turno em curso agora, calculado por horário (mesmos limites da Power App: 1º 05:20-13:48, 2º 13:48-22:41, 3º 22:41-05:20). Reavalia a cada carregamento do relatório.
	measure 'Turno Atual' = VAR minAtual = HOUR(NOW()) * 60 + MINUTE(NOW()) RETURN SWITCH(TRUE(), minAtual >= 320 && minAtual < 828, "1º Turno", minAtual >= 828 && minAtual < 1361, "2º Turno", "3º Turno")
		displayFolder: 13 Kanban Processos\Extrusora Mandril
		lineageTag: 3c8ae39b-ac79-416c-93e8-7ed5bbc30ed5

	/// Quantidade de Mandril produzida no turno EM CURSO (não histórico), por Bitola. Ignora qualquer slicer de data da página de propósito (ALL em dCalendario): o Kanban Extrusora sempre mostra o turno de agora, não o filtro selecionado. Após 00:00 e antes de 05:20, a data de referência recua 1 dia (3º turno cruza a meia-noite).
	measure 'Qtd Mandril Turno Atual' = VAR minAtual = HOUR(NOW()) * 60 + MINUTE(NOW()) VAR turnoAtual = [Turno Atual] VAR dataRef = IF(minAtual < 320, TODAY() - 1, TODAY()) RETURN CALCULATE(SUM(ficha_producao[quantidade_mandril]), ALL(dCalendario), dCalendario[Date] = dataRef, FILTER(ALL(ficha_producao[Turno_mandril]), VAR t = TRIM(FORMAT(ficha_producao[Turno_mandril], "")) VAR padrao = SWITCH(TRUE(), t IN {"1", "Turno 1"}, "1º Turno", t IN {"2", "Turno 2"}, "2º Turno", t IN {"3", "Turno 3"}, "3º Turno", BLANK()) RETURN padrao = turnoAtual))
		displayFolder: 13 Kanban Processos\Extrusora Mandril
		lineageTag: b6c1ac2a-0bb9-45f6-aa0b-a60148b8389b

	/// Quantidade AGORA aguardando ou em processo na etapa Tubo (WIP ao vivo, sem filtro de turno/data). Exclui processo=Finalizado (571 registros têm status_processo desatualizado após finalizar, achado documentado para MEL de limpeza de dado).
	measure 'Qtd Ativa Tubo (WIP)' = CALCULATE(COUNTROWS(ficha_producao), ALL(dCalendario), ficha_producao[processo] = "Tubo", ficha_producao[status_processo] IN {"Aguardando", "Em processo"})
		formatString: #,##0
		displayFolder: 13 Kanban Processos\Extração (filas)
		lineageTag: 07ebdf00-5265-4717-be29-a7afa4cd4ebb

	/// Quantidade AGORA aguardando ou em processo na etapa Trançadeira (WIP ao vivo). Mesma exclusão de Finalizado.
	measure 'Qtd Ativa Trancadeira (WIP)' = CALCULATE(COUNTROWS(ficha_producao), ALL(dCalendario), ficha_producao[processo] = "Trançadeira", ficha_producao[status_processo] IN {"Aguardando", "Em processo"})
		formatString: #,##0
		displayFolder: 13 Kanban Processos\Extração (filas)
		lineageTag: 15bb2f54-4ed5-4ab8-8f71-74e207052dcb

	/// PNs (Mangueira) ativos agora na etapa Tubo, para listar quais itens estão na fila. Usar como Linha de uma tabela filtrada por processo=Tubo, status Aguardando/Em processo.
	measure 'Qtd por PN Tubo Ativo' = CALCULATE(COUNTROWS(ficha_producao), ALL(dCalendario), ficha_producao[processo] = "Tubo", ficha_producao[status_processo] IN {"Aguardando", "Em processo"})
		formatString: #,##0
		displayFolder: 13 Kanban Processos\Extração (filas)
		lineageTag: cd8e58c9-fcd2-4c90-8c61-4e24bffb9028

