	column Mangueira_Limpa = VAR m = UPPER(TRIM('ficha_producao'[Mangueira])) VAR semZeroEsq = IF(LEFT(m,1) = "0" && NOT(MID(m,2,1) >= "0" && MID(m,2,1) <= "9"), MID(m, 2, LEN(m)), m) RETURN semZeroEsq
		lineageTag: 35be8a18-e81d-4701-b732-7879394502a3

	column Bitola_Corrigida = VAR mang = TRIM('ficha_producao'[Mangueira]) VAR temHifen = IFERROR(SEARCH("-", mang, 1, 0) > 0, FALSE) VAR sufixo = IF(temHifen, PATHITEM(SUBSTITUTE(mang, "-", "|"), 2), BLANK()) VAR digitos = IF(ISBLANK(sufixo), "", CONCATENATEX(GENERATESERIES(1, LEN(sufixo)), VAR c = MID(sufixo, [Value], 1) RETURN IF(c >= "0" && c <= "9", c, ""), "")) RETURN IF(digitos = "", BLANK(), VALUE(digitos))
		lineageTag: 7778dd64-ee15-4934-910d-0d9cd1c89346

	column Flag_Data_Invertida = VAR e1 = NOT(ISBLANK('ficha_producao'[data_hora_final_mandril])) && 'ficha_producao'[data_hora_final_mandril] < 'ficha_producao'[data_hora_inicio_mandril] VAR e2 = NOT(ISBLANK('ficha_producao'[data_hora_final_extracao])) && 'ficha_producao'[data_hora_final_extracao] < 'ficha_producao'[data_hora_inicio_extracao] VAR e3 = NOT(ISBLANK('ficha_producao'[data_hora_final_vulcanizacao])) && 'ficha_producao'[data_hora_final_vulcanizacao] < 'ficha_producao'[data_hora_inicio_vulcanizacao] RETURN e1 || e2 || e3
		lineageTag: 3634f730-fb47-445d-b009-261592508657

	column OP_Texto = VAR o = 'ficha_producao'[OP] RETURN IF(ISBLANK(o), BLANK(), SUBSTITUTE(FORMAT(o, "0"), ",", ""))
		lineageTag: b3121acb-29ea-4628-acbb-6e6ef3e3dc04

	column Metragem_Extracao = VAR t = TRIM('ficha_producao'[quantidade_extracao]) VAR norm = SUBSTITUTE(t, ",", ".") VAR posP = IFERROR(SEARCH(".", norm, 1, 0), 0) VAR semSep = SUBSTITUTE(norm, ".", "") VAR nCasas = IF(posP = 0, 0, LEN(norm) - posP) VAR valInt = IF(semSep = "", BLANK(), IFERROR(VALUE(semSep), BLANK())) RETURN IF(ISBLANK(t) || t = "" || ISBLANK(valInt), BLANK(), DIVIDE(valInt, POWER(10, nCasas)))
		lineageTag: 98589406-8c72-444a-9018-86a86e56db48

	column Turno_Extracao_Limpo = VAR t = TRIM('ficha_producao'[Turno_Extr/Teste]) RETURN SWITCH(TRUE(), t = "" || ISBLANK(t), "Não informado", t = "1" || t = "Turno 1", "Turno 1", t = "2" || t = "Turno 2", "Turno 2", t = "3" || t = "Turno 3", "Turno 3", t)
		lineageTag: e4ed5b70-870f-489b-b618-0b98be47f552

	column TempoCiclo_Horas = VAR ini = 'ficha_producao'[data_hora_inicio_mandril] VAR fim = 'ficha_producao'[data_hora_final_extracao] VAR horas = IF(ISBLANK(ini) || ISBLANK(fim), BLANK(), (fim - ini) * 24) RETURN IF(ISBLANK(horas) || horas < 0, BLANK(), horas)
		lineageTag: b58ca661-9728-41f3-bb01-9eca68d887c6

	column defeito_trancagem_trat = VAR d = 'ficha_producao'[defeito_trancagem] RETURN IF(ISBLANK(d) || d > 100 || d < 0, 0, d)
		lineageTag: f3683315-5d01-48a5-8c7a-a081591ba6fa

	column defeito_cobertura_trat = VAR d = 'ficha_producao'[defeito_cobertura] RETURN IF(ISBLANK(d) || d > 100 || d < 0, 0, d)
		lineageTag: f5319611-4270-4849-a36c-41ddfc7581fb

	column defeito_tubo_trat = VAR d = 'ficha_producao'[defeito_tubo] RETURN IF(ISBLANK(d) || d > 100 || d < 0, 0, d)
		lineageTag: 3170216e-dac1-448e-8d5b-a48dd1c6a6ce

	column Esta_Ativa = VAR maxMod = MAXX(ALL('ficha_producao'), 'ficha_producao'[Modified]) RETURN NOT('ficha_producao'[status_processo] IN {"Finalizado", "Descartado"}) && NOT(ISBLANK('ficha_producao'[Modified])) && 'ficha_producao'[Modified] >= maxMod - 4
		lineageTag: 0caa719a-51b9-4dc2-a1ea-978737e2fa3a

	column Flag_Qualidade_Bitola = VAR orig = 'ficha_producao'[Bitola] VAR corr = 'ficha_producao'[Bitola_Corrigida] VAR temMang = NOT(ISBLANK('ficha_producao'[Mangueira])) && TRIM('ficha_producao'[Mangueira]) <> "" RETURN SWITCH(TRUE(), NOT(temMang), "Sem mangueira", ISBLANK(corr), "Bitola irrecuperavel", ISBLANK(orig), "Bitola vazia - corrigida", orig <> corr, "Bitola divergente - corrigida", "OK")
		lineageTag: 1fc83b6d-3bcc-4ea9-9a85-8f0615a2090a

	column AnoMes_Producao = VAR d = 'ficha_producao'[data_hora_final_extracao] RETURN IF(ISBLANK(d) || 'ficha_producao'[Metragem_Extracao] <= 0, BLANK(), YEAR(d) * 100 + MONTH(d))
		lineageTag: 5f8bb951-0121-4595-a3c4-78cf2675c118

	column MesProducao = VAR d = 'ficha_producao'[data_hora_final_extracao] RETURN IF(ISBLANK(d) || 'ficha_producao'[Metragem_Extracao] <= 0, BLANK(), FORMAT(d, "mmm/yyyy", "pt-BR"))
		lineageTag: 54dfb607-d04f-415d-9610-a690fe184a19

	column Turno_Producao = VAR e = 'ficha_producao'[data_hora_final_extracao] VAR tm = HOUR(e) * 60 + MINUTE(e) VAR derived = SWITCH(TRUE(), tm >= 320 && tm < 820, "Turno 1", tm >= 820 && tm < 1340, "Turno 2", "Turno 3") VAR rec = 'ficha_producao'[Turno_Extracao_Limpo] VAR madrugada = tm < 320 RETURN SWITCH(TRUE(), ISBLANK(e), "Nao informado", madrugada && (rec = "Turno 1" || rec = "Turno 2"), rec, derived)
		lineageTag: 4886661d-b096-42e4-b0df-28cc3036c222

	column DataProducao = VAR d = 'ficha_producao'[data_hora_final_extracao] RETURN IF(ISBLANK(d) || 'ficha_producao'[Metragem_Extracao] <= 0, BLANK(), DATE(YEAR(d), MONTH(d), DAY(d)))
		lineageTag: eb8ede3c-f3a3-43a2-83fa-3a658f290a0a

