table ControleExtrusora_estrutura
	lineageTag: 491e514d-f15c-46c0-ae5c-0ed65d717da0

	/// Quantidade extrudada de mandril (ControleExtrusora_estrutura). Data vem de data_hora_inicio via join virtual com dCalendario (INT do datetime), pois a tabela não tem coluna de data pura.
	measure 'Qtd Extrusora Mandril' = VAR temCal = ISCROSSFILTERED(dCalendario[Date]) VAR datas = VALUES(dCalendario[Date]) RETURN IF(temCal, SUMX(FILTER(ControleExtrusora_estrutura, INT(ControleExtrusora_estrutura[data_hora_inicio]) IN datas), ControleExtrusora_estrutura[Quantidade]), SUM(ControleExtrusora_estrutura[Quantidade]))
		formatString: #,##0
		displayFolder: 11 Extrusora Mandril
		lineageTag: 47ab092b-07fa-4051-8f97-71b0ec3020f2

	/// Quantidade refugada na extrusora de mandril. Join virtual de data via INT(DataHoraRefugo).
	measure 'Refugo Extrusora Mandril' = VAR temCal = ISCROSSFILTERED(dCalendario[Date]) VAR datas = VALUES(dCalendario[Date]) RETURN IF(temCal, SUMX(FILTER(RefugoExtrusora_estrutura, INT(RefugoExtrusora_estrutura[DataHoraRefugo]) IN datas), RefugoExtrusora_estrutura[Quantidade]), SUM(RefugoExtrusora_estrutura[Quantidade]))
		formatString: #,##0
		displayFolder: 11 Extrusora Mandril
		lineageTag: 2439d72b-8e56-4360-bf6b-b02caa2c0ec7

	/// % de refugo da extrusora de mandril = refugo / (produzido + refugo).
	measure '% Refugo Extrusora' = DIVIDE([Refugo Extrusora Mandril], [Qtd Extrusora Mandril] + [Refugo Extrusora Mandril])
		formatString: 0.0%
		displayFolder: 11 Extrusora Mandril
		lineageTag: 9b80124e-0313-4d5b-881c-dc7fcbbd32be

