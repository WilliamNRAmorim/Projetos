table Hora-Hora
	lineageTag: 38f5963a-0e7f-41bd-9897-370d398a1e4a

	/// Meta acumulada do Hora-Hora (soma de Meta Hora) no contexto filtrado (célula/turno/dia).
	measure 'Meta HH' = SUM('Hora-Hora'[Meta Hora])
		formatString: #,0
		displayFolder: 08 Eficiência Célula
		lineageTag: 27342815-d0a0-4113-9a6b-050850b7696f

	/// Produção real do Hora-Hora (soma de Real. Hora) no contexto filtrado.
	measure 'Real HH' = SUM('Hora-Hora'[Real.Hora])
		displayFolder: 08 Eficiência Célula
		lineageTag: e41960f6-c869-4d0d-b6cc-4ef4ebac4982

	/// Eficiência = Real / Meta do Hora-Hora. Em branco quando não há meta no contexto (evita divisão por zero).
	measure '% Eficiência HH' = DIVIDE([Real HH], [Meta HH])
		formatString: 0%
		displayFolder: 08 Eficiência Célula
		lineageTag: a7a5854c-0ddc-4b01-a2d4-eb395fe1404f

	/// Minutos de parada registrados no Hora-Hora no contexto filtrado.
	measure 'Tempo Parado HH (min)' = SUM('Hora-Hora'[Tempo Parado (min)])
		formatString: #,0
		displayFolder: 08 Eficiência Célula
		lineageTag: 7931bea6-c4e5-4072-945e-140f6d812fc0

	/// Seta de tendência da eficiência: para cima quando Real >= Meta, para baixo quando abaixo. Mesmo padrão da Seta Etapa do CP Mangueira.
	measure 'Seta Eficiência HH' = VAR p = [% Eficiência HH] RETURN IF(NOT ISBLANK(p), IF(p >= 1, UNICHAR(9650), UNICHAR(9660)))
		displayFolder: 08 Eficiência Célula
		lineageTag: 4f10f9b5-2751-4066-a183-079aa4248abe

	/// % de eficiência com a seta na frente, para usar na matriz célula x dia (mesmo visual do Excel de eficiência).
	measure '% Eficiência HH c/ Seta' = VAR p = [% Eficiência HH] RETURN IF(NOT ISBLANK(p), [Seta Eficiência HH] & " " & FORMAT(p, "0%"))
		displayFolder: 08 Eficiência Célula
		lineageTag: 4b18e4d9-88d1-4ff8-b8f2-9d8608b29d1a

	/// Quantidade de células (trançadeiras) com eficiência abaixo de 100% no contexto filtrado. Para cartão de alerta da página Eficiência.
	measure 'Células Abaixo da Meta' = COUNTROWS(FILTER(VALUES('Hora-Hora'[Célula]), NOT ISBLANK([% Eficiência HH]) && [% Eficiência HH] < 1))
		formatString: 0
		displayFolder: 08 Eficiência Célula
		lineageTag: 70903748-964c-4130-ae79-28fd9ff55cb9

	/// Mangueira(s) da célula/turno/dia. Limitado a 3 itens distintos; acima disso mostra contagem, pois mais que isso indica falta de filtro de dia (uso indevido fora do kanban diário).
	measure 'Mangueira do Turno' = VAR lista = FILTER(VALUES('Hora-Hora'[Mangueira]), NOT ISBLANK('Hora-Hora'[Mangueira]) && 'Hora-Hora'[Mangueira] <> BLANK()) VAR qtd = COUNTROWS(lista) RETURN IF(qtd <= 3, CONCATENATEX(lista, 'Hora-Hora'[Mangueira], " / "), qtd & " mangueiras (selecione 1 dia)")
		displayFolder: 08 Eficiência Célula
		lineageTag: 3a037fa4-58b1-4176-9719-22010ac3fbc7

	/// Motivos distintos da célula/turno/dia, prefixo numérico removido. Limitado a 3 itens; acima mostra contagem, sinal de que falta filtro de dia.
	measure 'Motivos do Turno' = VAR lista = FILTER(VALUES('Hora-Hora'[Motivo]), NOT ISBLANK('Hora-Hora'[Motivo]) && 'Hora-Hora'[Motivo] <> BLANK()) VAR qtd = COUNTROWS(lista) VAR textoLimpo = CONCATENATEX(lista, SUBSTITUTE('Hora-Hora'[Motivo], LEFT('Hora-Hora'[Motivo], SEARCH(" - ", 'Hora-Hora'[Motivo] & " - ", 1) + 2), ""), " / ") RETURN IF(qtd = 0, BLANK(), IF(qtd <= 3, textoLimpo, qtd & " motivos (selecione 1 dia)"))
		displayFolder: 08 Eficiência Célula
		lineageTag: feabcedc-20aa-4556-ba61-c39d56b1672c

	column Turno
