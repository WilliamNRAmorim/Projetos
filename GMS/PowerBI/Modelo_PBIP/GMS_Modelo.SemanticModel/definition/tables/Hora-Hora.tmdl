		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Motivo Padrão' = VAR t = TRIM('Hora-Hora'[Motivo]) VAR p = IFERROR(SEARCH("-", t), 0) VAR pre = IF(p > 1, TRIM(LEFT(t, p - 1)), "") VAR limpo = IF(IFERROR(VALUE(pre), -1) >= 0, TRIM(MID(t, p + 1, 300)), t) RETURN IF(ISBLANK('Hora-Hora'[Motivo]), BLANK(), SWITCH(TRUE(), limpo = "Refeição", "Almoço", limpo = "Problema no tubo", "Análise/Problema no tubo", limpo))
		dataType: string
		lineageTag: eb411755-1a47-48e1-b85e-2bc77613426a
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Motivo 2 Padrão' = VAR t = TRIM('Hora-Hora'[Motivo 2]) VAR p = IFERROR(SEARCH("-", t), 0) VAR pre = IF(p > 1, TRIM(LEFT(t, p - 1)), "") VAR limpo = IF(IFERROR(VALUE(pre), -1) >= 0, TRIM(MID(t, p + 1, 300)), t) RETURN IF(ISBLANK('Hora-Hora'[Motivo 2]), BLANK(), SWITCH(TRUE(), limpo = "Refeição", "Almoço", limpo = "Problema no tubo", "Análise/Problema no tubo", limpo))
		dataType: string
		lineageTag: c50e6357-8be3-4109-8e0e-bc8b9fab2a2b
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition Hora-Hora = m
		mode: import
		source =
				let
				    Fonte = SharePoint.Tables("https://danfoss.sharepoint.com/sites/OperationsGuaratingueta", [Implementation="2.0", ViewMode="All"]),
				    #"463b6df3-c864-4b6c-8995-5926a238ee7a" = Fonte{[Id="463b6df3-c864-4b6c-8995-5926a238ee7a"]}[Items],
				    #"Tipo Alterado" = Table.TransformColumnTypes(#"463b6df3-c864-4b6c-8995-5926a238ee7a",{{"Data", type date}}),
				    #"Colunas Removidas" = Table.RemoveColumns(#"Tipo Alterado",{"Title", "Hora", "Meta Hora", "Meta Acum", "Mangueira", "Real. Hora", "Real. Acum", "Diferença", "Rendimento", "Status", "Color Tag", "Compliance Asset Id", "Modified", "ID", "Content Type", "Created", "Created By", "Modified By", "Version", "Attachments", "Edit", "Type", "Item Child Count", "Folder Child Count", "Label setting", "Retention label", "Retention label Applied", "Label applied by", "Item is a Record", "App Created By", "App Modified By"}),
				    #"Linhas Filtradas1" = Table.SelectRows(#"Colunas Removidas", each ([Célula] <> "") and ([Motivo] <> "" and [Motivo] <> "21 - Refeição"))
				in
				    #"Linhas Filtradas1"

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

