table Producao_Montagem
	lineageTag: 0b4c1af1-1947-4d8e-877c-3a5a685e3ef1

	/// Meta DIARIA de montagem no contexto de celula/turno da dMetaMontagem. Para periodos maiores que 1 dia, multiplicar por dias uteis. Fonte: aba META Mangueira Montagem do CP.
	measure 'Meta Montagem Dia' = SUM(dMetaMontagem[MetaDia])
		formatString: #,##0
		displayFolder: 10 CP Montagem
		lineageTag: 72d7610b-69a8-42c6-95e0-4c9a719a531f

	/// Producao de montagem (somente OPs Finalizado). Cruza com dMetaMontagem via TREATAS quando a matriz usa celula/turno da tabela de metas, dispensando relacionamento fisico.
	measure 'Real Montagem' = CALCULATE(SUM(Producao_Montagem[QtdProduzida]), Producao_Montagem[status] = "Finalizado", TREATAS(VALUES(dMetaMontagem[Celula]), Producao_Montagem[Celula]), TREATAS(VALUES(dMetaMontagem[Turno]), Producao_Montagem[Turno]))
		formatString: #,##0
		displayFolder: 10 CP Montagem
		lineageTag: 017d23fd-716d-4944-bfd8-ccccd53a6623

	/// % de atingimento da montagem = Real / Meta diaria. Em branco quando nao ha meta no contexto.
	measure '% Montagem' = DIVIDE([Real Montagem], [Meta Montagem Dia])
		formatString: 0%
		displayFolder: 10 CP Montagem
		lineageTag: dc068543-e55c-4241-a8ab-91aec4aca851

	/// % de montagem com seta de tendencia, mesmo padrao do CP Mangueira: para cima quando bateu a meta, para baixo abaixo.
	measure '% Montagem c/ Seta' = VAR p = [% Montagem] RETURN IF(NOT ISBLANK(p), IF(p >= 1, UNICHAR(9650), UNICHAR(9660)) & " " & FORMAT(p, "0%"))
		displayFolder: 10 CP Montagem
		lineageTag: 8e1eac0d-d64d-4f4b-bb06-d523ff8d2045

	/// Minutos de parada da montagem. Cruza celula/turno com dMetaMontagem via TREATAS para uso na mesma matriz de metas.
	measure 'Tempo Parado Montagem (min)' = CALCULATE(SUM(Paradas_Montagem[TempoParadoMin]), TREATAS(VALUES(dMetaMontagem[Celula]), Paradas_Montagem[Celula]), TREATAS(VALUES(dMetaMontagem[Turno]), Paradas_Montagem[Turno]))
		formatString: #,##0
		displayFolder: 10 CP Montagem
		lineageTag: eb242a75-f2df-4726-a77e-67a48c6b55d2

	/// Quantidade de OPs de montagem finalizadas no contexto.
	measure 'OPs Finalizadas Montagem' = CALCULATE(COUNTROWS(Producao_Montagem), Producao_Montagem[status] = "Finalizado")
		formatString: #,##0
		displayFolder: 10 CP Montagem
		lineageTag: 302ed6b2-819a-4f61-8573-6125376f6588

