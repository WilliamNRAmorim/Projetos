/// Tabela de datas do GMS (2025-2027).
table dCalendario
	lineageTag: 28e92706-be3e-4f7b-8b38-7aa8cd6ae0ff

	column Date
		lineageTag: d5e60ace-b31d-492a-a488-ec1584ca021f
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date]

		variation Variation
			isDefault
			relationship: fb37d039-c4b0-4071-92e6-db4d08155707
			defaultHierarchy: LocalDateTable_642b9bcf-865d-4e93-a809-4d5bf43b160c.'Hierarquia de datas'

		annotation SummarizationSetBy = Automatic

	column Ano
		lineageTag: c32c3b00-2b6e-40f4-882c-db5fa9a14f70
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Ano]

		annotation SummarizationSetBy = Automatic

	column 'Mês Nº'
		lineageTag: 66ab8203-ca3b-45c3-af44-82b4533133f2
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Mês Nº]

		annotation SummarizationSetBy = Automatic

	column Mês
		lineageTag: 263693ee-0381-43fe-a381-42708a14f222
		summarizeBy: none
		isNameInferred
		sourceColumn: [Mês]

		annotation SummarizationSetBy = Automatic

	column AnoMês
		lineageTag: 1e7ef5fd-44ac-4a30-94a1-6aebd6d53172
		summarizeBy: sum
		isNameInferred
		sourceColumn: [AnoMês]

		annotation SummarizationSetBy = Automatic

	column Dia
		lineageTag: 341127c1-e831-4a73-8fc9-52c81ce202d0
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Dia]

		annotation SummarizationSetBy = Automatic

	column 'Dia Semana'
		lineageTag: 93da5233-b88e-40ca-be14-88d900845654
		summarizeBy: none
		isNameInferred
		sourceColumn: [Dia Semana]

		annotation SummarizationSetBy = Automatic

	column Semana
		lineageTag: 68ca2113-6e3b-4753-b4ae-afd2c1004243
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Semana]

		annotation SummarizationSetBy = Automatic

	column Trimestre
		lineageTag: 40cdcab9-f9ed-427a-8e34-b946ce25dc6f
		summarizeBy: none
		isNameInferred
		sourceColumn: [Trimestre]

		annotation SummarizationSetBy = Automatic

	partition dCalendario = calculated
		mode: import
		source =
				ADDCOLUMNS (
				    CALENDAR ( DATE(2025,1,1), DATE(2027,12,31) ),
				    "Ano", YEAR([Date]),
				    "Mês Nº", MONTH([Date]),
				    "Mês", FORMAT([Date],"mmm","pt-BR"),
				    "AnoMês", YEAR([Date])*100+MONTH([Date]),
				    "Dia", DAY([Date]),
				    "Dia Semana", FORMAT([Date],"ddd","pt-BR"),
				    "Semana", WEEKNUM([Date],2),
				    "Trimestre", "T"&FORMAT([Date],"Q")
				)

