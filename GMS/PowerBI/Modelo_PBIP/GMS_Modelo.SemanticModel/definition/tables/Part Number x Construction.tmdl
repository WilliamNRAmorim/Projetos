	column C_Standard_Plan = VAR con = TRIM('Part Number x Construction'[Construction]) VAR dash = 'Part Number x Construction'[Dash size] RETURN IF(UPPER(con) = "TEXTILE", IF(dash <= 6, "TEXTILE-03/04/05/06", "TEXTILE-07/08/10/12/16"), con)
		lineageTag: 7851afc3-d287-4d04-8364-610e782f46a4

	column Decks_Plan = SWITCH('Part Number x Construction'[C_Standard_Plan], "TEXTILE-03/04/05/06", "Textil", "TEXTILE-07/08/10/12/16", "Textil", "SD24-08/10/12", "Wire SD (08-12)", "DD24-08/10/12", "Wire DD (08-12)", "SD20-04/06", "Wire SD (04-06)", "DD20-04/06", "Wire DD (04-06)", "SD/DD36-16", "Wire SD/DD (16)", "SPIRAL", "Spiral", 'Part Number x Construction'[C_Standard_Plan])
		lineageTag: 569b4957-4279-4395-96f9-942713b96185

	column Wires_Plan = SWITCH('Part Number x Construction'[C_Standard_Plan], "TEXTILE-03/04/05/06", "Textil", "TEXTILE-07/08/10/12/16", "Textil", "SD20-04/06", "Wire 20C", "DD20-04/06", "Wire 20C", "SD24-08/10/12", "Wire 24C", "DD24-08/10/12", "Wire 24C", "SD/DD36-16", "Wire 36C", "SPIRAL", "Spiral", 'Part Number x Construction'[C_Standard_Plan])
		lineageTag: 89790b3f-59d7-419d-b48b-071462b959ed

	column Tipo_Plan = SWITCH('Part Number x Construction'[C_Standard_Plan], "TEXTILE-03/04/05/06", "1T", "TEXTILE-07/08/10/12/16", "1T", "SD20-04/06", "1A", "SD24-08/10/12", "1A", "DD20-04/06", "2A", "DD24-08/10/12", "2A", "SPIRAL", "4A", "SD/DD36-16", "1A/2A (-16)", 'Part Number x Construction'[C_Standard_Plan])
		lineageTag: 2c95b570-5cfb-457c-afd4-33086e2fb236

	partition 'Part Number x Construction' = m
