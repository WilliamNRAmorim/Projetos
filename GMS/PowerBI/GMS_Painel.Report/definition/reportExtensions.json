{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/reportExtension/1.0.0/schema.json",
  "name": "extension",
  "entities": [
    {
      "name": "Medidas",
      "measures": [
        {
          "name": "Disponibilidade",
          "dataType": "Double",
          "expression": "[Disponibilidade %]",
          "formatString": "0.0%",
          "displayFolder": "Painel (relatório)",
          "references": {
            "measures": [
              {
                "entity": "Medidas",
                "name": "Disponibilidade %"
              }
            ]
          }
        },
        {
          "name": "Tempo Parado %",
          "dataType": "Double",
          "expression": "[% Tempo Parado]",
          "formatString": "0.0%",
          "displayFolder": "Painel (relatório)",
          "references": {
            "measures": [
              {
                "entity": "Medidas",
                "name": "% Tempo Parado"
              }
            ]
          }
        },
        {
          "name": "Δ Metragem vs mês ant.",
          "dataType": "Double",
          "expression": "VAR d = CALCULATE(MAX('ficha_producao'[DataProducao])) VAR ini = DATE(YEAR(d), MONTH(d), 1) VAR a = CALCULATE([Metragem Produzida], REMOVEFILTERS(dCalendario), DATESBETWEEN(dCalendario[Date], ini, d)) VAR b = CALCULATE([Metragem Produzida], REMOVEFILTERS(dCalendario), DATESBETWEEN(dCalendario[Date], EDATE(ini, -1), EDATE(d, -1))) RETURN IF(NOT ISBLANK(d) && NOT ISBLANK(a) && NOT ISBLANK(b) && b <> 0, DIVIDE(a - b, b))",
          "formatString": "+0.0%;-0.0%;0.0%",
          "displayFolder": "Painel (relatório)",
          "references": {
            "measures": [
              {
                "entity": "ficha_producao",
                "name": "Metragem Produzida"
              }
            ]
          }
        },
        {
          "name": "Δ Disponibilidade vs mês ant.",
          "dataType": "Double",
          "expression": "VAR d = CALCULATE(MAX('Hora-Hora'[Data])) VAR ini = DATE(YEAR(d), MONTH(d), 1) VAR a = CALCULATE([Disponibilidade %], REMOVEFILTERS(dCalendario), DATESBETWEEN(dCalendario[Date], ini, d)) VAR b = CALCULATE([Disponibilidade %], REMOVEFILTERS(dCalendario), DATESBETWEEN(dCalendario[Date], EDATE(ini, -1), EDATE(d, -1))) RETURN IF(NOT ISBLANK(d) && NOT ISBLANK(a) && NOT ISBLANK(b), a - b)",
          "formatString": "+0.0%;-0.0%;0.0%",
          "displayFolder": "Painel (relatório)",
          "references": {
            "measures": [
              {
                "entity": "Medidas",
                "name": "Disponibilidade %"
              }
            ]
          }
        },
        {
          "name": "Δ Tempo Parado vs mês ant.",
          "dataType": "Double",
          "expression": "VAR d = CALCULATE(MAX('Hora-Hora'[Data])) VAR ini = DATE(YEAR(d), MONTH(d), 1) VAR a = CALCULATE([% Tempo Parado], REMOVEFILTERS(dCalendario), DATESBETWEEN(dCalendario[Date], ini, d)) VAR b = CALCULATE([% Tempo Parado], REMOVEFILTERS(dCalendario), DATESBETWEEN(dCalendario[Date], EDATE(ini, -1), EDATE(d, -1))) RETURN IF(NOT ISBLANK(d) && NOT ISBLANK(a) && NOT ISBLANK(b), a - b)",
          "formatString": "+0.0%;-0.0%;0.0%",
          "displayFolder": "Painel (relatório)",
          "references": {
            "measures": [
              {
                "entity": "Medidas",
                "name": "% Tempo Parado"
              }
            ]
          }
        },
        {
          "name": "Δ Refugo PPM vs mês ant.",
          "dataType": "Double",
          "expression": "VAR d = CALCULATE(MAX('ficha_producao'[DataProducao])) VAR ini = DATE(YEAR(d), MONTH(d), 1) VAR a = CALCULATE([Refugo PPM], REMOVEFILTERS(dCalendario), DATESBETWEEN(dCalendario[Date], ini, d)) VAR b = CALCULATE([Refugo PPM], REMOVEFILTERS(dCalendario), DATESBETWEEN(dCalendario[Date], EDATE(ini, -1), EDATE(d, -1))) RETURN IF(NOT ISBLANK(d) && NOT ISBLANK(a) && NOT ISBLANK(b), a - b)",
          "formatString": "+#,0;-#,0;0",
          "displayFolder": "Painel (relatório)",
          "references": {
            "measures": [
              {
                "entity": "Medidas",
                "name": "Refugo PPM"
              }
            ]
          }
        },
        {
          "name": "Minutos Parados Montagem",
          "dataType": "Double",
          "expression": "SUM(Paradas_Montagem[TempoParadoMin])",
          "formatString": "#,0",
          "displayFolder": "Painel (relatório)"
        },
        {
          "name": "Quantidade Produzida Montagem",
          "dataType": "Double",
          "expression": "SUM(Producao_Montagem[QtdProduzida])",
          "formatString": "#,0",
          "displayFolder": "Painel (relatório)"
        },
        {
          "name": "OTs Montagem",
          "dataType": "Double",
          "expression": "DISTINCTCOUNT(Producao_Montagem[OT])",
          "formatString": "#,0",
          "displayFolder": "Painel (relatório)"
        },
        {
          "name": "Horas de OT Montagem",
          "dataType": "Double",
          "expression": "SUM(Producao_Montagem[DuracaoMin]) / 60",
          "formatString": "#,0.0",
          "displayFolder": "Painel (relatório)"
        },
        {
          "name": "Peças por Hora Montagem",
          "dataType": "Double",
          "expression": "DIVIDE(SUM(Producao_Montagem[QtdProduzida]), SUM(Producao_Montagem[DuracaoMin]) / 60)",
          "formatString": "#,0.0",
          "displayFolder": "Painel (relatório)"
        },
        {
          "name": "Parada Real Montagem (min)",
          "dataType": "Double",
          "expression": "CALCULATE(SUM(Paradas_Montagem[TempoParadoMin]), NOT(Paradas_Montagem[Motivo] IN {\"RF - Refeição\", \"TE - Tempo Excedido\"}))",
          "formatString": "#,0",
          "displayFolder": "Painel (relatório)"
        },
        {
          "name": "Minutos Brutos Montagem",
          "dataType": "Double",
          "expression": "CALCULATE(SUM(Paradas_Montagem[TempoParadoMin]), REMOVEFILTERS(Paradas_Montagem[Motivo]))",
          "formatString": "#,0",
          "displayFolder": "Painel (relatório)"
        },
        {
          "name": "Minutos Excedidos Montagem",
          "dataType": "Double",
          "expression": "CALCULATE(SUM(Paradas_Montagem[TempoParadoMin]), REMOVEFILTERS(Paradas_Montagem[Motivo]), Paradas_Montagem[Motivo] = \"TE - Tempo Excedido\")",
          "formatString": "#,0",
          "displayFolder": "Painel (relatório)"
        },
        {
          "name": "HH Meta (m)",
          "dataType": "Double",
          "expression": "SUM(fHoraHora[Meta Hora BI])",
          "formatString": "#,0",
          "displayFolder": "Painel (relatório)"
        },
        {
          "name": "HH Meta Útil (m)",
          "dataType": "Double",
          "expression": "SUM(fHoraHora[Meta Hora BI])",
          "formatString": "#,0",
          "displayFolder": "Painel (relatório)"
        },
        {
          "name": "HH Real (m)",
          "dataType": "Double",
          "expression": "SUM(fHoraHora[Real BI])",
          "formatString": "#,0",
          "displayFolder": "Painel (relatório)"
        },
        {
          "name": "HH Aderência",
          "dataType": "Double",
          "expression": "DIVIDE(SUM(fHoraHora[Real BI]), SUM(fHoraHora[Meta Hora BI]))",
          "formatString": "0%",
          "displayFolder": "Painel (relatório)"
        },
        {
          "name": "HH Parado (min)",
          "dataType": "Double",
          "expression": "CALCULATE(SUM(fHoraHora[Parado BI]), KEEPFILTERS(fHoraHora[Motivo Padrão] <> \"Almoço\"))",
          "formatString": "#,0",
          "displayFolder": "Painel (relatório)"
        },
        {
          "name": "HH Principal Parada",
          "dataType": "Text",
          "expression": "VAR t = ADDCOLUMNS(FILTER(VALUES(fHoraHora[Motivo Padrão]), NOT ISBLANK(fHoraHora[Motivo Padrão]) && fHoraHora[Motivo Padrão] <> \"Almoço\"), \"MinParado\", CALCULATE(SUM(fHoraHora[Parado BI]))) VAR topo = TOPN(1, FILTER(t, [MinParado] > 0), [MinParado], DESC) RETURN IF(COUNTROWS(topo) = 0, \"Sem parada\", MAXX(topo, fHoraHora[Motivo Padrão]))",
          "displayFolder": "Painel (relatório)"
        },
        {
          "name": "HH Dia Produtivo",
          "dataType": "Text",
          "expression": "VAR d1 = MIN(dCalendario[Date]) VAR d2 = MAX(dCalendario[Date]) RETURN IF(d1 = d2, \"Dia produtivo \" & FORMAT(d1, \"dd/mm\") & \": de \" & FORMAT(d1, \"dd/mm\") & \" 05:20 até \" & FORMAT(d1 + 1, \"dd/mm\") & \" 05:20\", \"Dias produtivos \" & FORMAT(d1, \"dd/mm\") & \" a \" & FORMAT(d2, \"dd/mm\") & \": cada dia vai das 05:20 às 05:20 do dia seguinte\")",
          "displayFolder": "Painel (relatório)"
        }
      ]
    }
  ]
}