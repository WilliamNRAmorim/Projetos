{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/reportExtension/1.0.0/schema.json",
  "name": "extension",
  "entities": [
    {
      "name": "Medidas",
      "measures": [
        {
          "name": "Disponibilidade",
          "dataType": "Double",
          "expression": "[Disponibilidade %]",
          "formatString": "0.0%",
          "displayFolder": "Painel (relatório)"
        },
        {
          "name": "Tempo Parado %",
          "dataType": "Double",
          "expression": "[% Tempo Parado]",
          "formatString": "0.0%",
          "displayFolder": "Painel (relatório)"
        },
        {
          "name": "Δ Metragem vs mês ant.",
          "dataType": "Double",
          "expression": "VAR a = [Metragem Produzida] VAR b = CALCULATE([Metragem Produzida], DATEADD(dCalendario[Date], -1, MONTH)) RETURN IF(NOT ISBLANK(b) && b <> 0, DIVIDE(a - b, b))",
          "formatString": "+0.0%;-0.0%;0.0%",
          "displayFolder": "Painel (relatório)"
        },
        {
          "name": "Δ Disponibilidade vs mês ant.",
          "dataType": "Double",
          "expression": "VAR a = [Disponibilidade %] VAR b = CALCULATE([Disponibilidade %], DATEADD(dCalendario[Date], -1, MONTH)) RETURN IF(NOT ISBLANK(b), a - b)",
          "formatString": "+0.0%;-0.0%;0.0%",
          "displayFolder": "Painel (relatório)"
        },
        {
          "name": "Δ Tempo Parado vs mês ant.",
          "dataType": "Double",
          "expression": "VAR a = [% Tempo Parado] VAR b = CALCULATE([% Tempo Parado], DATEADD(dCalendario[Date], -1, MONTH)) RETURN IF(NOT ISBLANK(b), a - b)",
          "formatString": "+0.0%;-0.0%;0.0%",
          "displayFolder": "Painel (relatório)"
        },
        {
          "name": "Fila Média (h)",
          "dataType": "Double",
          "expression": "AVERAGE(fFluxoEtapas[Fila_h])",
          "formatString": "0.0",
          "displayFolder": "Painel (relatório)"
        },
        {
          "name": "Processamento Médio (h)",
          "dataType": "Double",
          "expression": "AVERAGE(fFluxoEtapas[Proc_h])",
          "formatString": "0.0",
          "displayFolder": "Painel (relatório)"
        },
        {
          "name": "Lead Time Médio (h)",
          "dataType": "Double",
          "expression": "AVERAGE(fFluxoEtapas[Lead_h])",
          "formatString": "0.0",
          "displayFolder": "Painel (relatório)"
        },
        {
          "name": "Tempo Parado Montagem (min)",
          "dataType": "Double",
          "expression": "SUM(Paradas_Montagem[TempoParadoMin])",
          "formatString": "#,0",
          "displayFolder": "Painel (relatório)"
        },
        {
          "name": "Quantidade Produzida Montagem",
          "dataType": "Double",
          "expression": "SUM(Producao_Montagem[QtdProduzida])",
          "formatString": "#,0",
          "displayFolder": "Painel (relatório)"
        }
      ]
    }
  ]
}