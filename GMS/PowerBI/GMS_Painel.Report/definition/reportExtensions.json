{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/reportExtension/1.0.0/schema.json",
  "name": "extension",
  "entities": [
    {
      "name": "Medidas",
      "measures": [
        {
          "name": "Disponibilidade",
          "dataType": "Double",
          "expression": "[Disponibilidade %]",
          "formatString": "0.0%",
          "displayFolder": "Painel (relatório)",
          "references": {
            "measures": [
              {
                "entity": "Medidas",
                "name": "Disponibilidade %"
              }
            ]
          }
        },
        {
          "name": "Tempo Parado %",
          "dataType": "Double",
          "expression": "[% Tempo Parado]",
          "formatString": "0.0%",
          "displayFolder": "Painel (relatório)",
          "references": {
            "measures": [
              {
                "entity": "Medidas",
                "name": "% Tempo Parado"
              }
            ]
          }
        },
        {
          "name": "Δ Metragem vs mês ant.",
          "dataType": "Double",
          "expression": "VAR a = [Metragem Produzida] VAR b = CALCULATE([Metragem Produzida], PREVIOUSMONTH(dCalendario[Date])) RETURN IF(NOT ISBLANK(a) && NOT ISBLANK(b) && b <> 0, DIVIDE(a - b, b))",
          "formatString": "+0.0%;-0.0%;0.0%",
          "displayFolder": "Painel (relatório)",
          "references": {
            "measures": [
              {
                "entity": "ficha_producao",
                "name": "Metragem Produzida"
              }
            ]
          }
        },
        {
          "name": "Δ Disponibilidade vs mês ant.",
          "dataType": "Double",
          "expression": "VAR a = [Disponibilidade %] VAR b = CALCULATE([Disponibilidade %], PREVIOUSMONTH(dCalendario[Date])) RETURN IF(NOT ISBLANK(a) && NOT ISBLANK(b), a - b)",
          "formatString": "+0.0%;-0.0%;0.0%",
          "displayFolder": "Painel (relatório)",
          "references": {
            "measures": [
              {
                "entity": "Medidas",
                "name": "Disponibilidade %"
              }
            ]
          }
        },
        {
          "name": "Δ Tempo Parado vs mês ant.",
          "dataType": "Double",
          "expression": "VAR a = [% Tempo Parado] VAR b = CALCULATE([% Tempo Parado], PREVIOUSMONTH(dCalendario[Date])) RETURN IF(NOT ISBLANK(a) && NOT ISBLANK(b), a - b)",
          "formatString": "+0.0%;-0.0%;0.0%",
          "displayFolder": "Painel (relatório)",
          "references": {
            "measures": [
              {
                "entity": "Medidas",
                "name": "% Tempo Parado"
              }
            ]
          }
        },
        {
          "name": "Minutos Parados Montagem",
          "dataType": "Double",
          "expression": "SUM(Paradas_Montagem[TempoParadoMin])",
          "formatString": "#,0",
          "displayFolder": "Painel (relatório)"
        },
        {
          "name": "Quantidade Produzida Montagem",
          "dataType": "Double",
          "expression": "SUM(Producao_Montagem[QtdProduzida])",
          "formatString": "#,0",
          "displayFolder": "Painel (relatório)"
        }
      ]
    }
  ]
}