{
 "Permitidas": {
  "type": "Compose",
  "inputs": [
   "Eventos_Producao",
   "Hora-Hora",
   "TiposErros",
   "RegistrosInspeção",
   "ficha_producao",
   "Producao_Montagem",
   "Paradas_Montagem",
   "Plano_OPs",
   "Refugo_Bobinadeira",
   "RefugoExtrusora_estrutura",
   "Controle_Catenaria"
  ],
  "runAfter": {}
 },
 "Parametros": {
  "type": "Compose",
  "inputs": {
   "lista": "@{trim(coalesce(triggerBody()?['{{K_LISTA}}'], ''))}",
   "filtro": "@{trim(coalesce(triggerBody()?['{{K_FILTRO}}'], ''))}",
   "g1": "@{if(empty(trim(coalesce(triggerBody()?['{{K_AGRUPAR}}'], ''))), '', trim(first(split(triggerBody()?['{{K_AGRUPAR}}'], ','))))}",
   "g2": "@{if(greater(length(split(coalesce(triggerBody()?['{{K_AGRUPAR}}'], ''), ',')), 1), trim(split(triggerBody()?['{{K_AGRUPAR}}'], ',')[1]), '')}",
   "s": "@{trim(coalesce(triggerBody()?['{{K_SOMAR}}'], ''))}",
   "top": "@if(empty(trim(coalesce(triggerBody()?['{{K_TOP}}'], ''))), 1000, int(trim(triggerBody()?['{{K_TOP}}'])))"
  },
  "runAfter": {
   "Permitidas": [
    "Succeeded"
   ]
  }
 },
 "Valido": {
  "type": "If",
  "expression": {
   "and": [
    {
     "contains": [
      "@outputs('Permitidas')",
      "@outputs('Parametros')?['lista']"
     ]
    },
    {
     "not": {
      "equals": [
       "@outputs('Parametros')?['filtro']",
       ""
      ]
     }
    }
   ]
  },
  "actions": {
   "Ler_paginas": {
    "type": "Until",
    "expression": "@or(equals(variables('Uri'), ''), greaterOrEquals(variables('Paginas'), 10))",
    "limit": {
     "count": 12,
     "timeout": "PT80S"
    },
    "actions": {
     "Ler": {
      "type": "OpenApiConnection",
      "inputs": {
       "host": {
        "connectionName": "{{CONEXAO}}",
        "operationId": "HttpRequest",
        "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
       },
       "parameters": {
        "dataset": "https://danfoss.sharepoint.com/sites/OperationsGuaratingueta",
        "parameters/method": "GET",
        "parameters/uri": "@variables('Uri')",
        "parameters/headers": {
         "Accept": "application/json;odata=nometadata"
        }
       },
       "authentication": "@parameters('$authentication')"
      },
      "runAfter": {}
     },
     "Juntar": {
      "type": "Compose",
      "inputs": "@union(variables('Linhas'), body('Ler')?['value'])",
      "runAfter": {
       "Ler": [
        "Succeeded"
       ]
      }
     },
     "Guardar_linhas": {
      "type": "SetVariable",
      "inputs": {
       "name": "Linhas",
       "value": "@outputs('Juntar')"
      },
      "runAfter": {
       "Juntar": [
        "Succeeded"
       ]
      }
     },
     "Contar_pagina": {
      "type": "IncrementVariable",
      "inputs": {
       "name": "Paginas",
       "value": 1
      },
      "runAfter": {
       "Guardar_linhas": [
        "Succeeded"
       ]
      }
     },
     "Proxima_pagina": {
      "type": "SetVariable",
      "inputs": {
       "name": "Uri",
       "value": "@{if(empty(body('Ler')?['odata.nextLink']), '', replace(body('Ler')?['odata.nextLink'], 'https://danfoss.sharepoint.com/sites/OperationsGuaratingueta/', ''))}"
      },
      "runAfter": {
       "Contar_pagina": [
        "Succeeded"
       ]
      }
     }
    },
    "runAfter": {}
   },
   "Pares": {
    "type": "Select",
    "inputs": {
     "from": "@variables('Linhas')",
     "select": {
      "k": "@{if(empty(outputs('Parametros')?['g1']), 'total', concat(if(empty(string(item()?[outputs('Parametros')?['g1']])), '(vazio)', string(item()?[outputs('Parametros')?['g1']])), if(empty(outputs('Parametros')?['g2']), '', concat(' | ', if(empty(string(item()?[outputs('Parametros')?['g2']])), '(vazio)', string(item()?[outputs('Parametros')?['g2']]))))))}",
      "v": "@if(empty(outputs('Parametros')?['s']), 1, float(coalesce(item()?[outputs('Parametros')?['s']], 0)))"
     }
    },
    "runAfter": {
     "Ler_paginas": [
      "Succeeded"
     ]
    }
   },
   "So_chaves": {
    "type": "Select",
    "inputs": {
     "from": "@body('Pares')",
     "select": "@item()?['k']"
    },
    "runAfter": {
     "Pares": [
      "Succeeded"
     ]
    }
   },
   "Distintas": {
    "type": "Compose",
    "inputs": "@union(body('So_chaves'), body('So_chaves'))",
    "runAfter": {
     "So_chaves": [
      "Succeeded"
     ]
    }
   },
   "Poucos_grupos": {
    "type": "If",
    "expression": {
     "lessOrEquals": [
      "@length(outputs('Distintas'))",
      300
     ]
    },
    "actions": {
     "Cada_grupo": {
      "type": "Foreach",
      "foreach": "@outputs('Distintas')",
      "runtimeConfiguration": {
       "concurrency": {
        "repetitions": 20
       }
      },
      "actions": {
       "Do_grupo": {
        "type": "Query",
        "inputs": {
         "from": "@body('Pares')",
         "where": "@equals(item()?['k'], items('Cada_grupo'))"
        },
        "runAfter": {}
       },
       "Valores": {
        "type": "Select",
        "inputs": {
         "from": "@body('Do_grupo')",
         "select": "@item()?['v']"
        },
        "runAfter": {
         "Do_grupo": [
          "Succeeded"
         ]
        }
       },
       "Guardar_grupo": {
        "type": "AppendToArrayVariable",
        "inputs": {
         "name": "Grupos",
         "value": {
          "chave": "@items('Cada_grupo')",
          "soma": "@xpath(xml(json(concat('{\"r\":{\"v\":', string(body('Valores')), '}}'))), 'sum(/r/v)')",
          "linhas": "@length(body('Do_grupo'))"
         }
        },
        "runAfter": {
         "Valores": [
          "Succeeded"
         ]
        }
       }
      },
      "runAfter": {}
     },
     "Todos_valores": {
      "type": "Select",
      "inputs": {
       "from": "@body('Pares')",
       "select": "@item()?['v']"
      },
      "runAfter": {
       "Cada_grupo": [
        "Succeeded"
       ]
      }
     },
     "Responder_ok": {
      "type": "Response",
      "kind": "Skills",
      "inputs": {
       "statusCode": 200,
       "body": {
        "{{K_SAIDA}}": "@{string(outputs('Resultado'))}"
       },
       "schema": {
        "type": "object",
        "properties": {
         "{{K_SAIDA}}": {
          "title": "resultado",
          "type": "string",
          "x-ms-content-hint": "TEXT",
          "x-ms-dynamically-added": true
         }
        },
        "additionalProperties": {}
       }
      },
      "runAfter": {
       "Resultado": [
        "Succeeded"
       ]
      }
     },
     "Resultado": {
      "type": "Compose",
      "inputs": {
       "lista": "@outputs('Parametros')?['lista']",
       "filtro": "@outputs('Parametros')?['filtro']",
       "agrupar": "@{outputs('Parametros')?['g1']}@{if(empty(outputs('Parametros')?['g2']),'',concat(',',outputs('Parametros')?['g2']))}",
       "somar": "@if(empty(outputs('Parametros')?['s']),'(contagem)',outputs('Parametros')?['s'])",
       "total_soma": "@if(equals(length(body('Todos_valores')),0),0,xpath(xml(json(concat('{\"r\":{\"v\":',string(body('Todos_valores')),'}}'))),'sum(/r/v)'))",
       "total_linhas": "@length(variables('Linhas'))",
       "paginas_lidas": "@variables('Paginas')",
       "completo": "@equals(variables('Uri'),'')",
       "grupos_total": "@length(outputs('Distintas'))",
       "grupos": "@take(reverse(sort(variables('Grupos'),'soma')),outputs('Parametros')?['top'])"
      },
      "runAfter": {
       "Todos_valores": [
        "Succeeded"
       ]
      }
     }
    },
    "else": {
     "actions": {
      "Responder_muitos": {
       "type": "Response",
       "kind": "Skills",
       "inputs": {
        "statusCode": 200,
        "body": {
         "{{K_SAIDA}}": "{\"erro\":\"agrupamento com @{length(outputs('Distintas'))} grupos (limite 300): filtre mais ou agrupe por outra coluna\",\"total_linhas\":@{length(variables('Linhas'))}}"
        },
        "schema": {
         "type": "object",
         "properties": {
          "{{K_SAIDA}}": {
           "title": "resultado",
           "type": "string",
           "x-ms-content-hint": "TEXT",
           "x-ms-dynamically-added": true
          }
         },
         "additionalProperties": {}
        }
       },
       "runAfter": {}
      }
     }
    },
    "runAfter": {
     "Distintas": [
      "Succeeded"
     ]
    }
   }
  },
  "else": {
   "actions": {
    "Responder_invalido": {
     "type": "Response",
     "kind": "Skills",
     "inputs": {
      "statusCode": 200,
      "body": {
       "{{K_SAIDA}}": "{\"erro\":\"lista fora da lista permitida ou filtro vazio. Permitidas: @{join(outputs('Permitidas'), ', ')}\"}"
      },
      "schema": {
       "type": "object",
       "properties": {
        "{{K_SAIDA}}": {
         "title": "resultado",
         "type": "string",
         "x-ms-content-hint": "TEXT",
         "x-ms-dynamically-added": true
        }
       },
       "additionalProperties": {}
      }
     },
     "runAfter": {}
    }
   }
  },
  "runAfter": {
   "Ini_Grupos": [
    "Succeeded"
   ]
  }
 },
 "Ini_Uri": {
  "type": "InitializeVariable",
  "inputs": {
   "variables": [
    {
     "name": "Uri",
     "type": "string",
     "value": "_api/web/lists/getbytitle('@{encodeUriComponent(outputs('Parametros')?['lista'])}')/items?$select=ID@{if(empty(outputs('Parametros')?['g1']), '', concat(',', outputs('Parametros')?['g1']))}@{if(empty(outputs('Parametros')?['g2']), '', concat(',', outputs('Parametros')?['g2']))}@{if(empty(outputs('Parametros')?['s']), '', concat(',', outputs('Parametros')?['s']))}&$filter=@{encodeUriComponent(outputs('Parametros')?['filtro'])}&$orderby=ID&$top=5000"
    }
   ]
  },
  "runAfter": {
   "Parametros": [
    "Succeeded"
   ]
  }
 },
 "Ini_Linhas": {
  "type": "InitializeVariable",
  "inputs": {
   "variables": [
    {
     "name": "Linhas",
     "type": "array",
     "value": []
    }
   ]
  },
  "runAfter": {
   "Ini_Uri": [
    "Succeeded"
   ]
  }
 },
 "Ini_Paginas": {
  "type": "InitializeVariable",
  "inputs": {
   "variables": [
    {
     "name": "Paginas",
     "type": "integer",
     "value": 0
    }
   ]
  },
  "runAfter": {
   "Ini_Linhas": [
    "Succeeded"
   ]
  }
 },
 "Ini_Grupos": {
  "type": "InitializeVariable",
  "inputs": {
   "variables": [
    {
     "name": "Grupos",
     "type": "array",
     "value": []
    }
   ]
  },
  "runAfter": {
   "Ini_Paginas": [
    "Succeeded"
   ]
  }
 }
}